pub fn prelude() -> []string {
    return [
        "#include <stddef.h>",
        "#include <stdint.h>",
        "#include <stdio.h>",
        "#include <stdlib.h>",
        "#include <string.h>",
        "",
        "typedef struct { const char *data; int64_t len; } boot_str;",
        "typedef struct { int64_t *data; int64_t len, cap; } boot_ints;",
        "typedef struct { bool *data; int64_t len, cap; } boot_bools;",
        "typedef struct { boot_str *data; int64_t len, cap; } boot_strings;",
        "#define BOOT_STRING(s) ((boot_str){ (s), (int64_t)(sizeof(s) - 1) })",
        "",
        "struct boot_allocation { struct boot_allocation *next; max_align_t alignment; unsigned char data[]; };",
        "static struct boot_allocation *boot_allocations;",
        "",
        "static void boot_cleanup(void) {",
        "    while (boot_allocations) {",
        "        struct boot_allocation *next = boot_allocations->next;",
        "        free(boot_allocations);",
        "        boot_allocations = next;",
        "    }",
        "}",
        "",
        "static void boot_fail(const char *message) {",
        "    fputs(message, stderr);",
        "    exit(1);",
        "}",
        "",
        "static void *boot_alloc(int64_t count, size_t item_size) {",
        "    if (count < 0 || (uint64_t)count > (SIZE_MAX - sizeof(struct boot_allocation)) / item_size)",
        "        boot_fail(\"gors: allocation too large\\n\");",
        "    if (!boot_allocations && atexit(boot_cleanup))",
        "        boot_fail(\"gors: could not register cleanup\\n\");",
        "    struct boot_allocation *item = malloc(sizeof(*item) + (size_t)count * item_size);",
        "    if (!item) boot_fail(\"gors: out of memory\\n\");",
        "    item->next = boot_allocations;",
        "    boot_allocations = item;",
        "    return item->data;",
        "}",
        "",
        "[[maybe_unused]] static boot_str boot_concat(boot_str a, boot_str b) {",
        "    uint64_t size = (uint64_t)a.len + (uint64_t)b.len;",
        "    if (size > INT64_MAX) boot_fail(\"gors: string too large\\n\");",
        "    char *data = boot_alloc((int64_t)size, 1);",
        "    memcpy(data, a.data, (size_t)a.len);",
        "    memcpy(data + a.len, b.data, (size_t)b.len);",
        "    return (boot_str){ data, (int64_t)size };",
        "}",
        "",
        "",
        "[[maybe_unused]] static bool boot_str_equal(boot_str a, boot_str b) {",
        "    return a.len == b.len && memcmp(a.data, b.data, (size_t)a.len) == 0;",
        "}",
        "",
        "static void boot_index_check(int64_t i, int64_t len) {",
        "    if (i < 0 || i >= len) {",
        "        fprintf(stderr, \"gors: index %lld out of bounds (len %lld)\\n\", (long long)i, (long long)len);",
        "        exit(1);",
        "    }",
        "}",
        "",
        "static void boot_slice_check(int64_t low, int64_t high, int64_t len) {",
        "    if (low < 0 || high < low || high > len) {",
        "        fprintf(stderr, \"gors: slice bounds out of range [%lld:%lld] (len %lld)\\n\",",
        "                (long long)low, (long long)high, (long long)len);",
        "        exit(1);",
        "    }",
        "}",
        "",
        "static int64_t boot_grow(int64_t cap) {",
        "    if (cap > INT64_MAX / 2) boot_fail(\"gors: slice too large\\n\");",
        "    return cap ? cap * 2 : 4;",
        "}",
        "",
        "[[maybe_unused]] static boot_ints boot_make_ints(const int64_t *items, int64_t len) {",
        "    if (!len) return (boot_ints){0};",
        "    int64_t *data = boot_alloc(len, sizeof(*data));",
        "    memcpy(data, items, (size_t)len * sizeof(*data));",
        "    return (boot_ints){ data, len, len };",
        "}",
        "[[maybe_unused]] static int64_t *boot_index_ints(boot_ints slice, int64_t i) {",
        "    boot_index_check(i, slice.len);",
        "    return &slice.data[i];",
        "}",
        "[[maybe_unused]] static void boot_push_ints(boot_ints *slice, int64_t value) {",
        "    if (slice->len == slice->cap) {",
        "        int64_t cap = boot_grow(slice->cap);",
        "        int64_t *data = boot_alloc(cap, sizeof(*data));",
        "        if (slice->len) memcpy(data, slice->data, (size_t)slice->len * sizeof(*data));",
        "        slice->data = data;",
        "        slice->cap = cap;",
        "    }",
        "    slice->data[slice->len++] = value;",
        "}",
        "[[maybe_unused]] static boot_ints boot_slice_ints(boot_ints slice, int64_t low, int64_t high) {",
        "    boot_slice_check(low, high, slice.len);",
        "    if (high == low) return (boot_ints){0};",
        "    return boot_make_ints(slice.data + low, high - low);",
        "}",
        "",
        "[[maybe_unused]] static boot_bools boot_make_bools(const bool *items, int64_t len) {",
        "    if (!len) return (boot_bools){0};",
        "    bool *data = boot_alloc(len, sizeof(*data));",
        "    memcpy(data, items, (size_t)len * sizeof(*data));",
        "    return (boot_bools){ data, len, len };",
        "}",
        "[[maybe_unused]] static bool *boot_index_bools(boot_bools slice, int64_t i) {",
        "    boot_index_check(i, slice.len);",
        "    return &slice.data[i];",
        "}",
        "[[maybe_unused]] static void boot_push_bools(boot_bools *slice, bool value) {",
        "    if (slice->len == slice->cap) {",
        "        int64_t cap = boot_grow(slice->cap);",
        "        bool *data = boot_alloc(cap, sizeof(*data));",
        "        if (slice->len) memcpy(data, slice->data, (size_t)slice->len * sizeof(*data));",
        "        slice->data = data;",
        "        slice->cap = cap;",
        "    }",
        "    slice->data[slice->len++] = value;",
        "}",
        "[[maybe_unused]] static boot_bools boot_slice_bools(boot_bools slice, int64_t low, int64_t high) {",
        "    boot_slice_check(low, high, slice.len);",
        "    if (high == low) return (boot_bools){0};",
        "    return boot_make_bools(slice.data + low, high - low);",
        "}",
        "",
        "[[maybe_unused]] static boot_strings boot_make_strings(const boot_str *items, int64_t len) {",
        "    if (!len) return (boot_strings){0};",
        "    boot_str *data = boot_alloc(len, sizeof(*data));",
        "    memcpy(data, items, (size_t)len * sizeof(*data));",
        "    return (boot_strings){ data, len, len };",
        "}",
        "[[maybe_unused]] static boot_str *boot_index_strings(boot_strings slice, int64_t i) {",
        "    boot_index_check(i, slice.len);",
        "    return &slice.data[i];",
        "}",
        "[[maybe_unused]] static void boot_push_strings(boot_strings *slice, boot_str value) {",
        "    if (slice->len == slice->cap) {",
        "        int64_t cap = boot_grow(slice->cap);",
        "        boot_str *data = boot_alloc(cap, sizeof(*data));",
        "        if (slice->len) memcpy(data, slice->data, (size_t)slice->len * sizeof(*data));",
        "        slice->data = data;",
        "        slice->cap = cap;",
        "    }",
        "    slice->data[slice->len++] = value;",
        "}",
        "[[maybe_unused]] static boot_strings boot_slice_strings(boot_strings slice, int64_t low, int64_t high) {",
        "    boot_slice_check(low, high, slice.len);",
        "    if (high == low) return (boot_strings){0};",
        "    return boot_make_strings(slice.data + low, high - low);",
        "}",
        "",
        "#define BOOT_MAKE(data, len) _Generic((data), int64_t *: boot_make_ints, bool *: boot_make_bools, boot_str *: boot_make_strings)((data), (len))",
        "#define BOOT_INDEX(slice, i) _Generic((slice), boot_ints: boot_index_ints, boot_bools: boot_index_bools, boot_strings: boot_index_strings)((slice), (i))",
        "#define BOOT_PUSH(slice, value) _Generic((slice), boot_ints *: boot_push_ints, boot_bools *: boot_push_bools, boot_strings *: boot_push_strings)((slice), (value))",
        "#define BOOT_SLICE(value, low, high) _Generic((value), boot_str: boot_slice, boot_ints: boot_slice_ints, boot_bools: boot_slice_bools, boot_strings: boot_slice_strings)((value), (low), (high))",
        "",
        "[[maybe_unused]] static boot_strings boot_argv(int argc, char **argv) {",
        "    if (argc <= 1) return (boot_strings){0};",
        "    int64_t len = argc - 1;",
        "    boot_str *data = boot_alloc(len, sizeof(*data));",
        "    for (int64_t i = 0; i < len; ++i)",
        "        data[i] = (boot_str){ argv[i + 1], (int64_t)strlen(argv[i + 1]) };",
        "    return (boot_strings){ data, len, len };",
        "}",
        "",
        "[[maybe_unused]] static boot_str boot_slice(boot_str s, int64_t low, int64_t high) {",
        "    boot_slice_check(low, high, s.len);",
        "    return (boot_str){ s.data + low, high - low };",
        "}",
        "",
        "[[maybe_unused]] static void boot_int(FILE *file, int64_t n) { fprintf(file, \"%lld\", (long long)n); }",
        "[[maybe_unused]] static void boot_bool(FILE *file, bool b) { fputs(b ? \"true\" : \"false\", file); }",
        "[[maybe_unused]] static void boot_text(FILE *file, boot_str s) { fwrite(s.data, 1, (size_t)s.len, file); }",
        "#define BOOT_PRINT(file, value) _Generic((value), bool: boot_bool, boot_str: boot_text, default: boot_int)((file), (value))",
        "",
        "[[maybe_unused]] static int64_t boot_add(int64_t a, int64_t b) { return (int64_t)((uint64_t)a + (uint64_t)b); }",
        "[[maybe_unused]] static bool boot_equal(int64_t a, int64_t b) { return a == b; }",
        "#define BOOT_ADD(a, b) _Generic((a), boot_str: boot_concat, default: boot_add)((a), (b))",
        "#define BOOT_EQUAL(a, b) _Generic((a), boot_str: boot_str_equal, default: boot_equal)((a), (b))",
        "",
        "[[maybe_unused]] static int64_t boot_div(int64_t a, int64_t b) {",
        "    if (!b) boot_fail(\"gors: division by zero\\n\");",
        "    if (a == INT64_MIN && b == -1) return INT64_MIN;",
        "    return a / b;",
        "}",
        "",
        "[[maybe_unused]] static int64_t boot_rem(int64_t a, int64_t b) {",
        "    if (!b) boot_fail(\"gors: division by zero\\n\");",
        "    if (a == INT64_MIN && b == -1) return 0;",
        "    return a % b;",
        "}",
    ]
}
