import sema "../sema/checker.gors"
import imports "../parser/imports.gors"
import runtime "runtime.gors"
import native "native_runtime.gors"

struct Output {
    lines: []string,
    serial: int,
    depth: int,
    return_type_token: int,
}

fn digit(n: int) -> string {
    if n == 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    if n == 3 { return "3" }
    if n == 4 { return "4" }
    if n == 5 { return "5" }
    if n == 6 { return "6" }
    if n == 7 { return "7" }
    if n == 8 { return "8" }
    if n == 9 { return "9" }
    if n == 10 { return "a" }
    if n == 11 { return "b" }
    if n == 12 { return "c" }
    if n == 13 { return "d" }
    if n == 14 { return "e" }
    return "f"
}

fn decimal(n: int) -> string {
    if n < 10 { return digit(n) }
    return decimal(n / 10) + digit(n % 10)
}

// Escaping every source byte gives an injective C name, including for Unicode.
fn symbol(program: &sema::Checked, start: int, end: int, prefix: string) -> string {
    let mut result = prefix
    let mut i = start
    while i < end {
        let byte = program.graph.input.source[i]
        result = result + digit(byte / 16) + digit(byte % 16)
        i = i + 1
    }
    return result
}

fn (out: &mut Output) line(text: string) {
    let mut formatted = ""
    let mut i = 0
    while i < out.depth {
        formatted = formatted + "    "
        i = i + 1
    }
    push(&mut out.lines, formatted + text)
}

fn (out: &mut Output) temp() -> string {
    let name = "temp_" + decimal(out.serial)
    out.serial = out.serial + 1
    return name
}

fn (out: &mut Output) save(value: string) -> string {
    let name = out.temp()
    out.line("typeof_unqual(" + value + ") " + name + " = " + value + ";")
    return name
}

fn integer(program: &sema::Checked, first: int) -> Result<string, imports::ParseError> {
    let tok = &program.graph.input.tokens[first]
    let mut i = tok.start
    let mut value = 0
    while i < tok.end {
        let byte = program.graph.input.source[i]
        if byte != 95 {
            if byte < 48 || byte > 57 { return Err(program.issue(first, "invalid decimal integer")) }
            let d = byte - 48
            if value > (9223372036854775807 - d) / 10 {
                return Err(program.issue(first, "integer literal exceeds int"))
            }
            value = value * 10 + d
        }
        i = i + 1
    }
    return Ok("((int64_t)INT64_C(" + decimal(value) + "))")
}

fn octal_byte(byte: int) -> string {
    return "\\" + digit(byte / 64) + digit(byte / 8 % 8) + digit(byte % 8)
}

fn floating(program: &sema::Checked, first: int) -> Result<string, imports::ParseError> {
    let tok = &program.graph.input.tokens[first]
    let mut bytes: []int = []
    let mut i = tok.start
    let mut after_digit = false
    while i < tok.end {
        let byte = program.graph.input.source[i]
        if byte == 95 {
            if !after_digit || i + 1 == tok.end {
                return Err(program.issue(first, "invalid separator in float literal"))
            }
            let next = program.graph.input.source[i + 1]
            if next < 48 || next > 57 {
                return Err(program.issue(first, "invalid separator in float literal"))
            }
        } else {
            push(&mut bytes, byte)
        }
        after_digit = byte >= 48 && byte <= 57
        i = i + 1
    }
    return Ok(bytes_to_string(bytes))
}

fn quoted(program: &sema::Checked, first: int) -> string {
    let tok = &program.graph.input.tokens[first]
    let mut result = "BOOT_STRING(\""
    let mut i = tok.start + 1
    while i < tok.end - 1 {
        let mut byte = program.graph.input.source[i]
        i = i + 1
        if byte == 92 {
            byte = program.graph.input.source[i]
            i = i + 1
            if byte == 13 && program.graph.input.source[i] == 10 {
                byte = 10
                i = i + 1
            }
            if byte == 110 { byte = 10 } // n
            else if byte == 116 { byte = 9 } // t
            else if byte == 114 { byte = 13 } // r
            else if byte == 48 { byte = 0 } // 0
            else if byte != 92 && byte != 34 { result = result + octal_byte(92) }
        }
        result = result + octal_byte(byte)
    }
    return result + "\")"
}

fn base_type(typ: int) -> string {
    if typ == 0 { return "void" }
    if typ == 1 { return "int64_t" }
    if typ == 2 { return "double" }
    if typ == 3 { return "bool" }
    if typ == 4 { return "boot_str" }
    if typ == 11 { return "boot_ints" }
    if typ == 12 { return "boot_floats" }
    if typ == 13 { return "boot_bools" }
    if typ == 14 { return "boot_strings" }
    return ""
}

fn type_name(program: &sema::Checked, typ: int, token: int) -> Result<string, imports::ParseError> {
    if sema::is_reference(typ) {
        let base = type_name(program, sema::dereference(typ), token)?
        if sema::is_mut_reference(typ) { return Ok(base + " *") }
        return Ok("const " + base + " *")
    }
    if sema::is_struct_slice(typ) { return Ok("boot_struct_slice_" + decimal(sema::slice_element(typ) - 10000)) }
    if sema::is_struct(typ) { return Ok("boot_struct_" + decimal(typ - 10000)) }
    if sema::is_option(typ) { return Ok("boot_option") }
    if sema::is_result(typ) { return Ok("boot_result") }
    let name = base_type(typ)
    if len(name) != 0 { return Ok(name + "") }
    return Err(program.issue(token, "type is outside the C emitter subset"))
}

fn ctype(program: &sema::Checked, token: int) -> Result<string, imports::ParseError> {
    let typ = program.type_at(token)?
    return type_name(program, typ, token)
}

fn emit_structs(out: &mut Output, program: &sema::Checked) -> Result<bool, imports::ParseError> {
    for index in program.struct_order {
        let tag = "boot_struct_" + decimal(index)
        let slice = "boot_struct_slice_" + decimal(index)
        out.line("typedef struct " + tag + " " + tag + ";")
        out.line("typedef struct { " + tag + " *data; int64_t len, cap; } " + slice + ";")
    }
    for index in program.struct_order {
        let header = &program.headers[index]
        let tag = "boot_struct_" + decimal(index)
        out.line("struct " + tag + " {")
        out.depth = out.depth + 1
        if len(header.bindings) == 0 { out.line("unsigned char unused;") }
        for field in header.bindings {
            let typ = ctype(program, field.type_token)?
            let name = symbol(program, field.name.start, field.name.end, "field_")
            out.line(typ + " " + name + ";")
        }
        out.depth = out.depth - 1
        out.line("};")
    }
    emit_struct_slices(out, program)
    return Ok(true)
}

fn emit_struct_slices(out: &mut Output, program: &sema::Checked) {
    if len(program.struct_order) == 0 { return }
    let mut make = "BOOT_MAKE_SCALARS"
    let mut at = "BOOT_INDEX_SCALARS"
    let mut append = "BOOT_PUSH_SCALARS"
    for index in program.struct_order {
        let tag = "boot_struct_" + decimal(index)
        let slice = "boot_struct_slice_" + decimal(index)
        out.line("BOOT_DEFINE_SLICE(" + tag + ", " + slice + ")")
        make = make + ", " + tag + " *: boot_make_" + tag
        at = at + ", " + slice + ": boot_index_" + tag
        append = append + ", " + slice + " *: boot_push_" + tag
    }
    out.line("#undef BOOT_MAKE")
    out.line("#undef BOOT_INDEX")
    out.line("#undef BOOT_PUSH")
    out.line("#define BOOT_MAKE(data, len) _Generic((data), " + make + ")((data), (len))")
    out.line("#define BOOT_INDEX(slice, i) _Generic((slice), " + at + ")((slice), (i))")
    out.line("#define BOOT_PUSH(slice, value) _Generic((slice), " + append + ")((slice), (value))")
}

fn signature(program: &sema::Checked, index: int) -> Result<string, imports::ParseError> {
    let header = &program.headers[index]
    let ret = ctype(program, header.return_type_token)?
    let fname = function_name(program, index)
    let mut result = "static " + ret + " " + fname + "("
    if header.method {
        let receiver = &program.graph.input.tokens[header.receiver_name_token]
        let typ = ctype(program, header.receiver_type_token)?
        let mut label = symbol(program, receiver.start, receiver.end, "v_")
        if program.word(receiver.start, receiver.end, [95]) { label = "discard_receiver" }
        result = result + typ + " " + label
    } else if len(header.bindings) == 0 { result = result + "void" }
    for i, param in header.bindings {
        if i > 0 || header.method { result = result + ", " }
        let typ = ctype(program, param.type_token)?
        let mut pname = symbol(program, param.name.start, param.name.end, "v_")
        if program.word(param.name.start, param.name.end, [95]) { pname = "discard_" + decimal(i) }
        result = result + typ + " " + pname
    }
    return Ok(result + ")")
}

fn function_name(program: &sema::Checked, index: int) -> string {
    let header = &program.headers[index]
    if header.method { return "method_" + decimal(index) }
    return symbol(program, header.name.start, header.name.end, "fn_" + decimal(index) + "_")
}

fn print_kind(program: &sema::Checked, start: int, end: int) -> int {
    if program.word(start, end, [112, 114, 105, 110, 116]) { return 1 } // print
    if program.word(start, end, [112, 114, 105, 110, 116, 108, 110]) { return 2 } // println
    if program.word(start, end, [101, 112, 114, 105, 110, 116, 108, 110]) { return 3 } // eprintln
    return 0
}

fn emit_call(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let callee = &program.tree.nodes[node.children[0]]
    if callee.kind == "field" {
        let receiver_id = callee.children[0]
        let actual = program.expr_types[receiver_id]
        let method_index = program.method(actual, callee.children[1])?
        let expected_receiver = program.type_at(program.headers[method_index].receiver_type_token)?
        let receiver = emit_receiver(out, program, receiver_id, actual, expected_receiver)?
        return emit_user_call(out, program, id, method_index, receiver)
    }
    if callee.next != callee.first + 1 {
        let linked = program.function(callee.first, callee.next)?
        return emit_user_call(out, program, id, linked, "")
    }
    let tok = &program.graph.input.tokens[callee.first]
    let variant = program.variant(node.children[0])
    if variant == 3 {
        let typ = program.expr_types[id]
        let name = type_name(program, typ, callee.first)?
        let payload = type_name(program, sema::option_payload(typ), callee.first)?
        let data = emit_typed_expr(out, program, node.children[1], payload)?
        return Ok(out.save("(" + name + "){ .some = true, .val = BOOT_BOX((" + data + ")) }"))
    }
    if variant != 0 {
        let typ = program.expr_types[id]
        let name = type_name(program, typ, callee.first)?
        let payload = type_name(program, sema::result_variant_type(typ, variant), callee.first)?
        let data = emit_typed_expr(out, program, node.children[1], payload)?
        if variant == 1 { return Ok(out.save("(" + name + "){ .ok = true, .val = BOOT_BOX((" + data + ")) }")) }
        return Ok(out.save("(" + name + "){ .err = BOOT_BOX((" + data + ")) }"))
    }
    if program.word(tok.start, tok.end, [114, 101, 97, 100, 95, 98, 121, 116, 101, 115]) { // read_bytes
        let path = emit_expr(out, program, node.children[1])?
        return Ok(out.save("boot_read_bytes(" + path + ")"))
    }
    if program.word(tok.start, tok.end, [119, 114, 105, 116, 101, 95, 116, 101, 120, 116]) { // write_text
        let path_value = emit_expr(out, program, node.children[1])?
        let text_value = emit_expr(out, program, node.children[2])?
        return Ok(out.save("boot_write_text(" + path_value + ", " + text_value + ")"))
    }
    if program.word(tok.start, tok.end, [98, 121, 116, 101, 115, 95, 116, 111, 95, 115, 116, 114, 105, 110, 103]) {
        let bytes = emit_typed_expr(out, program, node.children[1], "boot_ints")?
        return Ok(out.save("boot_bytes_to_string(" + bytes + ")"))
    }
    if program.word(tok.start, tok.end, [110, 97, 116, 105, 118, 101, 95, 99]) { // native_c
        let source = emit_expr(out, program, node.children[1])?
        let output = emit_expr(out, program, node.children[2])?
        let argv = emit_typed_expr(out, program, node.children[3], "boot_strings")?
        return Ok(out.save("boot_native_c(" + source + ", " + output + ", " + argv + ")"))
    }
    if program.word(tok.start, tok.end, [112, 117, 115, 104]) { // push
        let slice = emit_expr(out, program, node.children[1])?
        let value = emit_expr(out, program, node.children[2])?
        out.line("BOOT_PUSH(" + slice + ", " + value + ");")
        return Ok("")
    }
    if program.word(tok.start, tok.end, [108, 101, 110]) { // len
        let value = emit_expr(out, program, node.children[1])?
        return Ok(out.save("(" + value + ").len"))
    }
    let printing = print_kind(program, tok.start, tok.end)
    if printing != 0 {
        let mut stream = "stdout"
        if printing == 3 { stream = "stderr" }
        let mut args: []string = []
        let mut i = 1
        while i < len(node.children) {
            let value = emit_read(out, program, node.children[i])?
            push(&mut args, value)
            i = i + 1
        }
        for j, arg in args {
            if j > 0 { out.line("fputc(' ', " + stream + ");") }
            out.line("BOOT_PRINT(" + stream + ", " + *arg + ");")
        }
        if printing >= 2 { out.line("fputc('\\n', " + stream + ");") }
        return Ok("")
    }

    let function_index = program.function(callee.first, callee.next)?
    if function_index < 0 { return Err(program.issue(callee.first, "call is outside the C emitter subset")) }
    return emit_user_call(out, program, id, function_index, "")
}

fn emit_receiver(out: &mut Output, program: &sema::Checked, id: int, actual: int, expected: int) -> Result<string, imports::ParseError> {
    if sema::is_mut_reference(expected) && !sema::is_reference(actual) {
        let place = emit_place(out, program, id)?
        return Ok(out.save("&(" + place + ")"))
    }
    let value = emit_expr(out, program, id)?
    if sema::is_reference(expected) && !sema::is_reference(actual) {
        return Ok(out.save("&(" + value + ")"))
    }
    if !sema::is_reference(expected) && sema::is_reference(actual) {
        return Ok(out.save("*(" + value + ")"))
    }
    if !sema::is_reference(expected) { return Ok(out.save(value + "")) }
    return Ok(value)
}

fn emit_user_call(out: &mut Output, program: &sema::Checked, id: int, function_index: int, receiver: string) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let ret_token = program.headers[function_index].return_type_token
    let mut text = function_name(program, function_index) + "(" + receiver
    let mut k = 1
    while k < len(node.children) {
        if k > 1 || program.headers[function_index].method { text = text + ", " }
        let expected = ctype(program, program.headers[function_index].bindings[k - 1].type_token)?
        let arg_text = emit_typed_expr(out, program, node.children[k], expected)?
        let arg_value = out.save(arg_text)
        text = text + arg_value
        k = k + 1
    }
    text = text + ")"
    if ret_token < 0 {
        out.line(text + ";")
        return Ok("")
    }
    return Ok(out.save(text))
}

fn emit_binary(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let op = node.kind[7:]
    let left = emit_expr(out, program, node.children[0])?
    if op == "&&" || op == "||" {
        let name = out.temp()
        out.line("bool " + name + " = " + left + ";")
        if op == "&&" { out.line("if (" + name + ") {") }
        else { out.line("if (!" + name + ") {") }
        out.depth = out.depth + 1
        let right_cond = emit_expr(out, program, node.children[1])?
        out.line(name + " = " + right_cond + ";")
        out.depth = out.depth - 1
        out.line("}")
        return Ok(name)
    }
    let right = emit_expr(out, program, node.children[1])?
    if program.expr_types[node.children[0]] == 2 {
        let text = "(" + left + " " + op + " " + right + ")"
        if program.expr_types[id] == 3 { return Ok(out.save("(bool)" + text)) }
        return Ok(out.save(text))
    }
    if op == "+" { return Ok(out.save("BOOT_ADD(" + left + ", " + right + ")")) }
    if op == "==" { return Ok(out.save("BOOT_EQUAL(" + left + ", " + right + ")")) }
    if op == "!=" { return Ok(out.save("(bool)!BOOT_EQUAL(" + left + ", " + right + ")")) }
    if op == "-" || op == "*" {
        return Ok(out.save("(int64_t)((uint64_t)" + left + " " + op + " (uint64_t)" + right + ")"))
    }
    if op == "/" { return Ok(out.save("boot_div(" + left + ", " + right + ")")) }
    if op == "%" { return Ok(out.save("boot_rem(" + left + ", " + right + ")")) }
    return Ok(out.save("(bool)(" + left + " " + op + " " + right + ")"))
}

fn emit_expr(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    if node.kind == "INT" { return integer(program, node.first) }
    if node.kind == "FLOAT" { return floating(program, node.first) }
    if node.kind == "STRING" { return Ok(quoted(program, node.first)) }
    if node.kind == "true" || node.kind == "false" { return Ok("(bool)" + node.kind) }
    if node.kind == "name" {
        if program.variant(id) == 4 {
            let typ = type_name(program, program.expr_types[id], node.first)?
            return Ok("(" + typ + "){0}")
        }
        let tok = &program.graph.input.tokens[node.first]
        return Ok(symbol(program, tok.start, tok.end, "v_"))
    }
    if node.kind == "group" { return emit_expr(out, program, node.children[0]) }
    if node.kind == "unary:&" || node.kind == "unary:&mut" {
        let place = emit_place(out, program, node.children[0])?
        return Ok(out.save("&(" + place + ")"))
    }
    if node.kind == "unary:*" {
        let pointer = emit_expr(out, program, node.children[0])?
        return Ok(out.save("*(" + pointer + ")"))
    }
    if node.kind == "try" {
        let result = emit_expr(out, program, node.children[0])?
        let temp = out.save(result)
        out.line("if (!" + temp + ".ok) return (boot_result){ .err = " + temp + ".err };")
        let payload = type_name(program, program.expr_types[id], node.first)?
        return Ok(out.save("*(" + payload + " *)" + temp + ".val"))
    }
    if node.kind == "call" { return emit_call(out, program, id) }
    if node.kind == "struct_literal" { return emit_struct_literal(out, program, id) }
    if node.kind == "field" {
        let base = emit_expr(out, program, node.children[0])?
        return Ok(out.save(member_access(program, node.children[0], node.children[1], base)))
    }
    if node.kind == "match_expression" { return emit_match(out, program, id) }
    if node.kind == "slice_literal" { return emit_slice_literal(out, program, id) }
    if node.kind == "index" || node.kind == "slice" {
        return emit_subscript(out, program, id)
    }
    if len(node.kind) >= 7 && node.kind[:7] == "binary:" { return emit_binary(out, program, id) }
    if node.kind == "unary:!" {
        let cond = emit_expr(out, program, node.children[0])?
        return Ok(out.save("(bool)(!" + cond + ")"))
    }
    if node.kind == "unary:-" {
        let value = emit_expr(out, program, node.children[0])?
        if program.expr_types[id] == 2 { return Ok(out.save("-(" + value + ")")) }
        return Ok(out.save("(int64_t)(UINT64_C(0) - (uint64_t)" + value + ")"))
    }
    return Err(program.issue(node.first, "expression is outside the C emitter subset"))
}

fn emit_typed_expr(out: &mut Output, program: &sema::Checked, id: int, expected: string) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    if node.kind == "group" { return emit_typed_expr(out, program, node.children[0], expected + "") }
    if node.kind == "slice_literal" && len(node.children) == 0 { return Ok("(" + expected + "){0}") }
    return emit_expr(out, program, id)
}

fn field_name(program: &sema::Checked, id: int) -> string {
    let tok = &program.graph.input.tokens[program.tree.nodes[id].first]
    return symbol(program, tok.start, tok.end, "field_")
}

fn member_access(program: &sema::Checked, base_id: int, field_id: int, base: string) -> string {
    let member = field_name(program, field_id)
    if sema::is_reference(program.expr_types[base_id]) { return "(" + base + ")->" + member }
    return "(" + base + ")." + member
}

fn emit_struct_literal(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let typ = type_name(program, program.expr_types[id], node.first)?
    let mut value = "(" + typ + "){"
    if len(node.children) == 1 { value = value + "0" }
    let mut i = 1
    while i < len(node.children) {
        let init = &program.tree.nodes[node.children[i]]
        let member = field_name(program, init.children[0])
        let data_id = init.children[1]
        let expected = type_name(program, program.expr_types[data_id], init.first)?
        let data = emit_typed_expr(out, program, data_id, expected)?
        value = value + "." + member + " = " + data + ", "
        i = i + 1
    }
    return Ok(out.save(value + "}"))
}

fn emit_slice_literal(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let count = len(node.children)
    if count == 0 { return Err(program.issue(node.first, "empty slice needs an explicit type context")) }
    let first = emit_expr(out, program, node.children[0])?
    let mut items = first + ""
    let mut i = 1
    while i < count {
        let item = emit_expr(out, program, node.children[i])?
        items = items + ", " + item
        i = i + 1
    }
    return Ok(out.save("BOOT_MAKE(((typeof_unqual(" + first + ")[]){" + items + "}), " + decimal(count) + ")"))
}

fn emit_read(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let value = emit_expr(out, program, id)?
    if sema::is_reference(program.expr_types[id]) { return Ok("(*(" + value + "))") }
    return Ok(value)
}

fn emit_subscript(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let base = emit_read(out, program, node.children[0])?
    let mut low = "INT64_C(0)"
    if node.children[1] >= 0 { low = emit_expr(out, program, node.children[1])? }
    if node.kind == "index" { return Ok(out.save("*BOOT_INDEX(" + base + ", " + low + ")")) }
    let mut high = "(" + base + ").len"
    if node.children[2] >= 0 { high = emit_expr(out, program, node.children[2])? }
    return Ok(out.save("BOOT_SLICE(" + base + ", " + low + ", " + high + ")"))
}

fn emit_contents(out: &mut Output, program: &sema::Checked, id: int) -> Result<bool, imports::ParseError> {
    let node = &program.tree.nodes[id]
    for child in node.children {
        let emitted = emit_stmt(out, program, child)?
    }
    return Ok(true)
}

fn emit_body(out: &mut Output, program: &sema::Checked, id: int) -> Result<bool, imports::ParseError> {
    out.depth = out.depth + 1
    let emitted = emit_contents(out, program, id)?
    out.depth = out.depth - 1
    out.line("}")
    return Ok(true)
}

fn emit_loop_binding(out: &mut Output, program: &sema::Checked, id: int, value: string) {
    if id < 0 { return }
    let node = &program.tree.nodes[id]
    let tok = &program.graph.input.tokens[node.first]
    if program.word(tok.start, tok.end, [95]) { return }
    let label = symbol(program, tok.start, tok.end, "v_")
    out.line("typeof_unqual(" + value + ") " + label + " = " + value + ";")
}

fn emit_for(out: &mut Output, program: &sema::Checked, id: int) -> Result<bool, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let values = emit_read(out, program, node.children[2])?
    let iter = out.save(values)
    let i = out.temp()
    out.line("for (int64_t " + i + " = 0; " + i + " < " + iter + ".len; ++" + i + ") {")
    out.depth = out.depth + 1
    emit_loop_binding(out, program, node.children[0], i + "")
    let mut element = "BOOT_INDEX(" + iter + ", " + i + ")"
    let slice = sema::dereference(program.expr_types[node.children[2]])
    if sema::is_struct_slice(slice) || slice == 14 { element = "(const typeof(*" + element + ") *)" + element }
    else { element = "*" + element }
    emit_loop_binding(out, program, node.children[1], element)
    let emitted = emit_contents(out, program, node.children[3])?
    out.depth = out.depth - 1
    out.line("}")
    return Ok(true)
}

fn emit_place(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let target = &program.tree.nodes[id]
    if target.kind == "group" { return emit_place(out, program, target.children[0]) }
    if target.kind == "unary:*" {
        let pointer = emit_expr(out, program, target.children[0])?
        return Ok("(*(" + pointer + "))")
    }
    if target.kind == "field" {
        let base = emit_place(out, program, target.children[0])?
        return Ok(member_access(program, target.children[0], target.children[1], base))
    }
    if target.kind == "index" {
        let mut base = emit_place(out, program, target.children[0])?
        if sema::is_reference(program.expr_types[target.children[0]]) { base = "(*(" + base + "))" }
        let i = emit_expr(out, program, target.children[1])?
        let address = out.save("BOOT_INDEX(" + base + ", " + i + ")")
        return Ok("*" + address)
    }
    let tok = &program.graph.input.tokens[target.first]
    return Ok(symbol(program, tok.start, tok.end, "v_"))
}

fn emit_assignment(out: &mut Output, program: &sema::Checked, id: int) -> Result<bool, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let lvalue = emit_place(out, program, node.children[0])?
    let result = emit_typed_expr(out, program, node.children[1], "typeof(" + lvalue + ")")?
    out.line(lvalue + " = " + result + ";")
    return Ok(true)
}

fn emit_match_arm(out: &mut Output, program: &sema::Checked, id: int, subject: string, subject_type: int,
    target: string, typ: string) -> Result<bool, imports::ParseError> {
    let arm = &program.tree.nodes[id]
    let pat = &program.tree.nodes[arm.children[0]]
    let mut field = ".err"
    let variant = program.variant(pat.children[0])
    if variant == 1 || variant == 3 { field = ".val" }
    if pat.children[1] >= 0 {
        let mut payload_type = sema::option_payload(subject_type)
        if sema::is_result(subject_type) { payload_type = sema::result_variant_type(subject_type, variant) }
        let name = type_name(program, payload_type, pat.first)?
        emit_loop_binding(out, program, pat.children[1], "*(" + name + " *)" + subject + field)
    }
    let body_id = arm.children[1]
    let body = &program.tree.nodes[body_id]
    if len(target) == 0 {
        if body.kind == "block" { return emit_contents(out, program, body_id) }
        let ignored = emit_expr(out, program, body_id)?
        if len(ignored) != 0 { out.line("(void)(" + ignored + ");") }
        return Ok(true)
    }
    let mut value_id = body_id
    if body.kind == "block" {
        let mut i = 0
        while i + 1 < len(body.children) {
            let emitted = emit_stmt(out, program, body.children[i])?
            i = i + 1
        }
        value_id = program.tree.nodes[body.children[i]].children[0]
    }
    let value = emit_typed_expr(out, program, value_id, typ)?
    out.line(target + " = " + value + ";")
    return Ok(true)
}

fn emit_match(out: &mut Output, program: &sema::Checked, id: int) -> Result<string, imports::ParseError> {
    let node = &program.tree.nodes[id]
    let value = emit_expr(out, program, node.children[0])?
    let subject = out.save(value)
    let mut target = ""
    let mut typ = ""
    if node.kind == "match_expression" {
        target = out.temp()
        typ = type_name(program, program.expr_types[id], node.first)?
        out.line(typ + " " + target + ";")
    }
    let first = &program.tree.nodes[node.children[1]]
    let pat = &program.tree.nodes[first.children[0]]
    let variant = program.variant(pat.children[0])
    let mut tag = ".ok"
    if sema::is_option(program.expr_types[node.children[0]]) { tag = ".some" }
    if variant == 1 || variant == 3 { out.line("if (" + subject + tag + ") {") }
    else { out.line("if (!" + subject + tag + ") {") }
    out.depth = out.depth + 1
    let subject_type = program.expr_types[node.children[0]]
    let emitted_first = emit_match_arm(out, program, node.children[1], subject + "", subject_type, target + "", typ + "")?
    out.depth = out.depth - 1
    out.line("} else {")
    out.depth = out.depth + 1
    let emitted_second = emit_match_arm(out, program, node.children[2], subject, subject_type, target + "", typ)?
    out.depth = out.depth - 1
    out.line("}")
    return Ok(target)
}

fn emit_stmt(out: &mut Output, program: &sema::Checked, id: int) -> Result<bool, imports::ParseError> {
    let node = &program.tree.nodes[id]
    if node.kind == "assign" { return emit_assignment(out, program, id) }
    if node.kind == "match_statement" {
        let emitted = emit_match(out, program, id)?
        return Ok(true)
    }
    if node.kind == "let" || node.kind == "let_mut" {
        let name = &program.tree.nodes[node.children[0]]
        let tok = &program.graph.input.tokens[name.first]
        let label = symbol(program, tok.start, tok.end, "v_")
        let mut initialized = ""
        if node.children[1] < 0 { initialized = emit_expr(out, program, node.children[2])? }
        else {
            let annotation = &program.tree.nodes[node.children[1]]
            let typ = ctype(program, annotation.first)?
            initialized = emit_typed_expr(out, program, node.children[2], typ)?
        }
        if program.word(tok.start, tok.end, [95]) { out.line("(void)(" + initialized + ");") }
        else { out.line("typeof_unqual(" + initialized + ") " + label + " = " + initialized + ";") }
        return Ok(true)
    }
    if node.kind == "expr_stmt" {
        let value = emit_expr(out, program, node.children[0])?
        if len(value) != 0 { out.line("(void)(" + value + ");") }
        return Ok(true)
    }
    if node.kind == "return" {
        if len(node.children) == 0 { out.line("return;") }
        else {
            let typ = ctype(program, out.return_type_token)?
            let result = emit_typed_expr(out, program, node.children[0], typ)?
            out.line("return " + result + ";")
        }
        return Ok(true)
    }
    if node.kind == "block" {
        out.line("{")
        return emit_body(out, program, id)
    }
    if node.kind == "if" {
        let cond = emit_expr(out, program, node.children[1])?
        out.line("if (" + cond + ") {")
        let branch = emit_body(out, program, node.children[2])?
        if node.children[3] >= 0 {
            out.line("else {")
            out.depth = out.depth + 1
            let otherwise = emit_stmt(out, program, node.children[3])?
            out.depth = out.depth - 1
            out.line("}")
        }
        return Ok(true)
    }
    if node.kind == "while" {
        out.line("while (true) {")
        out.depth = out.depth + 1
        let control = emit_expr(out, program, node.children[0])?
        out.line("if (!" + control + ") break;")
        let loop_body = emit_contents(out, program, node.children[1])?
        out.depth = out.depth - 1
        out.line("}")
        return Ok(true)
    }
    if node.kind == "for" { return emit_for(out, program, id) }
    if node.kind == "break" || node.kind == "continue" {
        out.line(node.kind + ";")
        return Ok(true)
    }
    return Err(program.issue(node.first, "statement is outside the C emitter subset"))
}

pub fn emit(program: &sema::Checked) -> Result<[]string, imports::ParseError> {
    let mut out = Output { lines: runtime::prelude(), serial: 0, depth: 0, return_type_token: -1 }
    for line in runtime::files() { out.line(*line + "") }
    for line in native::lines() { out.line(*line + "") }
    for line in runtime::native_adapter() { out.line(*line + "") }
    let structs = emit_structs(&mut out, program)?
    out.line("")
    for i, declaration in program.headers {
        if declaration.kind != "fn" { continue }
        let prototype = signature(program, i)?
        out.line(prototype + ";")
    }
    out.line("")
    let mut root = 0
    for j, header in program.headers {
        if header.kind != "fn" { continue }
        out.return_type_token = header.return_type_token
        let definition = signature(program, j)?
        out.line(definition + " {")
        let emitted = emit_body(&mut out, program, program.tree.roots[root])?
        root = root + 1
        out.line("")
    }
    let main_index = find_main(program)
    let main_header = &program.headers[main_index]
    let entry = function_name(program, main_index)
    let mut invoke = entry + "()"
    if len(main_header.bindings) == 0 { out.line("int main(void) {") }
    else {
        out.line("int main(int argc, char **argv) {")
        invoke = entry + "(boot_argv(argc, argv))"
    }
    if main_header.return_type_token >= 0 { out.line("    return (int)((uint64_t)" + invoke + " & 255);") }
    else {
        out.line("    " + invoke + ";")
        out.line("    return 0;")
    }
    out.line("}")
    return Ok(out.lines)
}

fn find_main(program: &sema::Checked) -> int {
    for i, _ in program.headers {
        if program.is_entry(i) { return i }
    }
    return -1
}
