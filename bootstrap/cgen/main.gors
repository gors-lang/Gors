import sema "../sema/checker.gors"
import imports "../parser/imports.gors"
import cgen "emitter.gors"

fn compile(path: &string, bytes: []int) -> Result<[]string, imports::ParseError> {
    let program = sema::analyze_file(path, bytes)?
    return cgen::emit(&program)
}

fn join_lines(lines: &[]string, first: int, end: int) -> string {
    if first == end { return "" }
    if end - first == 1 { return (*lines)[first] + "\n" }
    let middle = first + (end - first) / 2
    return join_lines(lines, first, middle) + join_lines(lines, middle, end)
}

fn write_output(path: &string, lines: &[]string) -> int {
    let text = join_lines(lines, 0, len(*lines))
    match write_text(*path, text) {
        Ok(_) => { return 0 }
        Err(issue) => { eprintln("gors-bootstrap:", *path, issue); return 2 }
    }
}

fn emit_file(path: &string, bytes: []int, output: &string) -> int {
    match compile(path, bytes) {
        Ok(lines) => {
            if *output != "" { return write_output(output, &lines) }
            for line in lines { println(*line) }
            return 0
        }
        Err(issue) => {
            eprintln(issue.line, issue.col, issue.message)
            return 1
        }
    }
}

fn compile_file(path: &string, output: &string) -> int {
    match read_bytes(*path) {
        Ok(bytes) => { return emit_file(path, bytes, output) }
        Err(issue) => { eprintln("gors-bootstrap:", *path, issue); return 2 }
    }
}

fn native_file(path: &string, output: &string, args: &[]string) -> int {
    match read_bytes(*path) {
        Ok(source) => {
            match compile(path, source) {
                Ok(lines) => {
                    let c_source = join_lines(&lines, 0, len(lines))
                    return native_c(c_source, *output, *args)
                }
                Err(issue) => { eprintln(issue.line, issue.col, issue.message); return 1 }
            }
        }
        Err(issue) => { eprintln("gors-bootstrap:", *path, issue); return 2 }
    }
}

fn main(args: []string) -> int {
    if len(args) == 2 && args[0] == "emit" {
        let output = ""
        return compile_file(&args[1], &output)
    }
    if len(args) == 4 && args[0] == "emit" && args[2] == "-o" && args[3] != "" {
        return compile_file(&args[1], &args[3])
    }
    if len(args) == 4 && args[0] == "build" && args[2] == "-o" && args[3] != "" {
        let empty: []string = []
        return native_file(&args[1], &args[3], &empty)
    }
    if len(args) >= 2 && args[0] == "run" && (len(args) == 2 || args[2] == "--") {
        let mut forwarded: []string = []
        let mut i = 3
        while i < len(args) {
            push(&mut forwarded, args[i] + "")
            i = i + 1
        }
        let temporary = ""
        return native_file(&args[1], &temporary, &forwarded)
    }
    eprintln("usage: gors-bootstrap emit <file> [-o <output.c>]")
    eprintln("       gors-bootstrap build <file> -o <executable>")
    eprintln("       gors-bootstrap run <file> [-- arguments...]")
    return 2
}
