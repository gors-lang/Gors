pub fn lines() -> []string {
    return [
        "#include <errno.h>",
        "#ifdef _WIN32",
        "#include <windows.h>",
        "#include <direct.h>",
        "#else",
        "#include <unistd.h>",
        "#include <sys/wait.h>",
        "extern char *mkdtemp(char *);",
        "#endif",
        "",
        "static int native_process(char *const *argv) {",
        "#ifdef _WIN32",
        "    size_t cap = 1;",
        "    for (size_t i = 0; argv[i]; ++i) {",
        "        size_t n = strlen(argv[i]);",
        "        if (cap > SIZE_MAX - 3 || n > (SIZE_MAX - cap - 3) / 2) return 1;",
        "        cap += n * 2 + 3;",
        "    }",
        "    char *line = malloc(cap);",
        "    if (!line) return 1;",
        "    char *p = line;",
        "    for (size_t i = 0; argv[i]; ++i) {",
        "        if (i) *p++ = ' ';",
        "        *p++ = '\"';",
        "        const char *s = argv[i];",
        "        for (;;) {",
        "            size_t slashes = 0;",
        "            while (*s == '\\\\') { ++slashes; ++s; }",
        "            size_t escapes = slashes;",
        "            if (*s == '\"' || *s == 0) escapes += slashes;",
        "            if (*s == '\"') ++escapes;",
        "            while (escapes--) *p++ = '\\\\';",
        "            if (!*s) break;",
        "            *p++ = *s++;",
        "        }",
        "        *p++ = '\"';",
        "    }",
        "    *p = 0;",
        "    STARTUPINFOA startup = {0};",
        "    PROCESS_INFORMATION process = {0};",
        "    startup.cb = sizeof(startup);",
        "    startup.dwFlags = STARTF_USESTDHANDLES;",
        "    startup.hStdInput = GetStdHandle(STD_INPUT_HANDLE);",
        "    startup.hStdOutput = GetStdHandle(STD_OUTPUT_HANDLE);",
        "    startup.hStdError = GetStdHandle(STD_ERROR_HANDLE);",
        "    BOOL started = CreateProcessA(NULL, line, NULL, NULL, TRUE, 0, NULL, NULL, &startup, &process);",
        "    free(line);",
        "    if (!started) {",
        "        fprintf(stderr, \"gors-bootstrap: could not launch %s\\n\", argv[0]);",
        "        return 127;",
        "    }",
        "    DWORD code = 1;",
        "    if (WaitForSingleObject(process.hProcess, INFINITE) == WAIT_OBJECT_0)",
        "        GetExitCodeProcess(process.hProcess, &code);",
        "    CloseHandle(process.hThread);",
        "    CloseHandle(process.hProcess);",
        "    return (int)(code & 255);",
        "#else",
        "    pid_t child = fork();",
        "    if (child < 0) {",
        "        perror(\"gors-bootstrap: fork\");",
        "        return 1;",
        "    }",
        "    if (!child) {",
        "        execvp(argv[0], argv);",
        "        perror(argv[0]);",
        "        _exit(127);",
        "    }",
        "    int status;",
        "    while (waitpid(child, &status, 0) < 0) {",
        "        if (errno == EINTR) continue;",
        "        perror(\"gors-bootstrap: waitpid\");",
        "        return 1;",
        "    }",
        "    if (WIFEXITED(status)) return WEXITSTATUS(status);",
        "    if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);",
        "    return 1;",
        "#endif",
        "}",
        "",
        "static char *native_directory(const char *output) {",
        "    const char *dir = \"\";",
        "    size_t len = 0;",
        "#ifdef _WIN32",
        "    char system_temp[MAX_PATH + 1];",
        "#endif",
        "    if (output[0]) {",
        "        dir = output;",
        "        for (size_t i = 0; output[i]; ++i) {",
        "            if (output[i] == '/') len = i + 1;",
        "#ifdef _WIN32",
        "            if (output[i] == '\\\\') len = i + 1;",
        "#endif",
        "        }",
        "#ifdef _WIN32",
        "        if (!len && output[1] == ':') len = 2;",
        "#endif",
        "    } else {",
        "#ifdef _WIN32",
        "        DWORD n = GetTempPathA(sizeof(system_temp), system_temp);",
        "        if (!n || n >= sizeof(system_temp)) return NULL;",
        "        dir = system_temp;",
        "#else",
        "        dir = getenv(\"TMPDIR\");",
        "        if (!dir || !dir[0]) dir = \"/tmp\";",
        "#endif",
        "        len = strlen(dir);",
        "    }",
        "    if (len > SIZE_MAX - 64) return NULL;",
        "    char *name = malloc(len + 64);",
        "    if (!name) return NULL;",
        "    memcpy(name, dir, len);",
        "    if (!output[0] && len && dir[len - 1] != '/' && dir[len - 1] != '\\\\') name[len++] = '/';",
        "#ifdef _WIN32",
        "    for (unsigned i = 0; i < 128; ++i) {",
        "        snprintf(name + len, 64, \".gors-%lu-%u\", (unsigned long)GetCurrentProcessId(), i);",
        "        if (CreateDirectoryA(name, NULL)) return name;",
        "        if (GetLastError() != ERROR_ALREADY_EXISTS) break;",
        "    }",
        "#else",
        "    memcpy(name + len, \".gors-XXXXXX\", sizeof(\".gors-XXXXXX\"));",
        "    if (mkdtemp(name)) return name;",
        "#endif",
        "    free(name);",
        "    return NULL;",
        "}",
        "",
        "[[maybe_unused]] static int native_c(const char *text, size_t size, const char *output,",
        "                                   char **args, size_t count) {",
        "    char *dir = native_directory(output);",
        "    if (!dir) {",
        "        fputs(\"gors-bootstrap: could not create a temporary directory\\n\", stderr);",
        "        return 2;",
        "    }",
        "    size_t cap = strlen(dir) + 32;",
        "    char *source = malloc(cap);",
        "    char *binary = malloc(cap);",
        "    int status = 2;",
        "    if (!source || !binary) {",
        "        fputs(\"gors-bootstrap: out of memory\\n\", stderr);",
        "        goto cleanup;",
        "    }",
        "    snprintf(source, cap, \"%s/main.c\", dir);",
        "#ifdef _WIN32",
        "    snprintf(binary, cap, \"%s/program.exe\", dir);",
        "#else",
        "    snprintf(binary, cap, \"%s/program\", dir);",
        "#endif",
        "    FILE *file = fopen(source, \"wb\");",
        "    bool written = file && fwrite(text, 1, size, file) == size;",
        "    if (file && fclose(file) != 0) written = false;",
        "    if (!written) {",
        "        fputs(\"gors-bootstrap: could not write temporary C source\\n\", stderr);",
        "        goto cleanup_files;",
        "    }",
        "    char *gcc[] = {\"gcc\", \"-std=c23\", \"-O2\", source, \"-o\", binary, NULL};",
        "    status = native_process(gcc);",
        "    if (status) goto cleanup_files;",
        "    if (output[0]) {",
        "#ifdef _WIN32",
        "        bool moved = MoveFileExA(binary, output, MOVEFILE_REPLACE_EXISTING) != 0;",
        "#else",
        "        bool moved = rename(binary, output) == 0;",
        "#endif",
        "        if (!moved) {",
        "            fputs(\"gors-bootstrap: could not replace the output executable\\n\", stderr);",
        "            status = 2;",
        "        }",
        "    } else {",
        "        if (count > SIZE_MAX / sizeof(char *) - 2) {",
        "            status = 2;",
        "            goto cleanup_files;",
        "        }",
        "        char **argv = malloc((count + 2) * sizeof(*argv));",
        "        if (!argv) {",
        "            status = 2;",
        "            goto cleanup_files;",
        "        }",
        "        argv[0] = binary;",
        "        for (size_t i = 0; i < count; ++i) argv[i + 1] = args[i];",
        "        argv[count + 1] = NULL;",
        "        status = native_process(argv);",
        "        free(argv);",
        "    }",
        "cleanup_files:",
        "    remove(source);",
        "    remove(binary);",
        "cleanup:",
        "    free(source);",
        "    free(binary);",
        "#ifdef _WIN32",
        "    RemoveDirectoryA(dir);",
        "#else",
        "    rmdir(dir);",
        "#endif",
        "    free(dir);",
        "    return status;",
        "}",
    ]
}
