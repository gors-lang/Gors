import lexer "../lexer/lexer.gors"

pub struct ImportDecl {
    line: int,
    col: int,
    alias_start: int,
    alias_end: int,
    path_start: int,
    path_end: int,
}

pub struct ImportPrefix {
    imports: []ImportDecl,
    next_token: int,
}

pub struct ParseError {
    line: int,
    col: int,
    message: string,
}

// Parse leading imports, leaving the first declaration for the next parser stage.
pub fn parse_imports(input: &lexer::Lexed) -> Result<ImportPrefix, ParseError> {
    return parse_imports_from(input, 0)
}

pub fn parse_imports_from(input: &lexer::Lexed, start: int) -> Result<ImportPrefix, ParseError> {
    let mut imports: []ImportDecl = []
    let mut i = start
    let count = len(input.tokens)
    while i < count {
        let first = &input.tokens[i]
        if first.kind == ";" {
            i = i + 1
            continue
        }
        if first.kind == "pub" && i + 1 < count {
            let next = &input.tokens[i + 1]
            if next.kind == "import" {
                return Err(ParseError {
                    line: next.line, col: next.col, message: "an import cannot be public",
                })
            }
        }
        if first.kind != "import" { break }
        if i + 1 >= count {
            return Err(ParseError { line: first.line, col: first.col, message: "expected import alias" })
        }
        let alias = &input.tokens[i + 1]
        if alias.kind != "IDENT" {
            return Err(ParseError { line: alias.line, col: alias.col, message: "expected import alias" })
        }
        if i + 2 >= count {
            return Err(ParseError { line: alias.line, col: alias.col, message: "expected quoted import path" })
        }
        let path = &input.tokens[i + 2]
        if path.kind != "STRING" {
            return Err(ParseError { line: path.line, col: path.col, message: "expected quoted import path" })
        }
        push(&mut imports, ImportDecl {
            line: first.line, col: first.col,
            alias_start: alias.start, alias_end: alias.end,
            path_start: path.start + 1, path_end: path.end - 1,
        })
        i = i + 3
    }
    return Ok(ImportPrefix { imports: imports, next_token: i })
}
