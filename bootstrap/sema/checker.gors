import lexer "../lexer/lexer.gors"
import decl "../parser/declarations.gors"
import bodies "../parser/bodies.gors"
import imports "../parser/imports.gors"
import modules "modules.gors"

// A type code is 0 for void, 1 for int, 2 for float, 3 for bool, 4 for string.
// Each slice layer adds 10.
// Struct and struct slice codes carry the declaration index.
// Variant codes pack payload type codes into separate ranges.
struct Local {
    start: int,
    end: int,
    typ: int,
    mutable: bool,
    moved: bool,
    owner: int,
    last_use: int,
}

struct Loan {
    owner: int,
    mutable: bool,
}

struct Scope {
    locals: []Local,
    visible: int,
    loop_depth: int,
    return_type: int,
    types: []int,
    name_uses: []bool,
    loans: []Loan,
    loan_count: int,
    block_end: int,
    loop_locals: int,
}

pub struct Checked {
    graph: modules::Graph,
    headers: []decl::Declaration,
    tree: bodies::Bodies,
    expr_types: []int,
    struct_order: []int,
}

pub fn is_struct(typ: int) -> bool { return typ >= 10000 && typ < 10000000 }
pub fn is_struct_slice(typ: int) -> bool { return typ >= 10000000 && typ < 20000000 }
fn is_slice(typ: int) -> bool { return (typ >= 10 && typ < 32) || is_struct_slice(typ) }
fn slice_type(elem: int) -> int {
    if is_struct(elem) { return 10000000 + elem - 10000 }
    return elem + 10
}
pub fn slice_element(typ: int) -> int {
    if is_struct_slice(typ) { return typ - 10000000 + 10000 }
    return typ - 10
}

pub fn is_result(typ: int) -> bool { return typ >= 100000000 }
pub fn is_option(typ: int) -> bool { return typ > 20000000 && typ < 40000000 }
pub fn option_type(payload: int) -> int { return 20000000 + payload }
pub fn option_payload(typ: int) -> int { return typ - 20000000 }
fn is_payload(typ: int) -> bool {
    return (typ >= 1 && typ <= 4) || is_struct(typ) || is_slice(typ)
}

pub fn is_reference(typ: int) -> bool { return typ <= -100002 }
pub fn is_mut_reference(typ: int) -> bool { return is_reference(typ) && (-typ - 100000) % 2 == 1 }
pub fn dereference(typ: int) -> int {
    if is_reference(typ) { return (-typ - 100000) / 2 }
    return typ
}
fn reference(typ: int, mutable: bool) -> int {
    if mutable { return -100001 - 2 * typ }
    return -100000 - 2 * typ
}

pub fn result_type(success: int, failure: int) -> int {
    return 100000000 + 20000000 * success + failure
}

pub fn file_result_type() -> int { return result_type(11, 4) }
pub fn write_result_type() -> int { return result_type(3, 4) }

pub fn result_variant_type(typ: int, variant: int) -> int {
    if variant == 1 { return (typ - 100000000) / 20000000 }
    return (typ - 100000000) % 20000000
}

pub fn (c: &Checked) word(start: int, end: int, expected: []int) -> bool {
    if end - start != len(expected) { return false }
    let mut i = 0
    while i < len(expected) {
        if c.graph.input.source[start + i] != expected[i] { return false }
        i = i + 1
    }
    return true
}

fn (c: &Checked) same_name(a: int, a_end: int, b: int, b_end: int) -> bool {
    if a_end - a != b_end - b { return false }
    let mut i = 0
    while i < a_end - a {
        if c.graph.input.source[a + i] != c.graph.input.source[b + i] { return false }
        i = i + 1
    }
    return true
}

pub fn (c: &Checked) issue(token: int, message: string) -> imports::ParseError {
    if token >= 0 && token < len(c.graph.input.tokens) {
        let file = c.graph.input.tokens[token].file
        if file > 0 { return decl::error_at(&c.graph.input, token, c.graph.files[file].path + ": " + message) }
    }
    return decl::error_at(&c.graph.input, token, message)
}

pub fn (c: &Checked) type_at(start: int) -> Result<int, imports::ParseError> {
    if start < 0 { return Ok(0) }
    if decl::at(&c.graph.input, start, "&") {
        let mutable = decl::at(&c.graph.input, start + 1, "mut")
        let mut next = start + 1
        if mutable { next = next + 1 }
        let inner = c.type_at(next)?
        if inner <= 0 { return Err(c.issue(start, "bootstrap references require a value type")) }
        return Ok(reference(inner, mutable))
    }
    let mut i = start
    let mut layers = 0
    while decl::at(&c.graph.input, i, "[") {
        layers = layers + 10
        i = i + 2
    }
    if layers > 10 { return Err(c.issue(start, "nested slices are outside the bootstrap subset")) }
    let tok = &c.graph.input.tokens[i]
    if decl::at(&c.graph.input, i + 1, "::") {
        let qualified = c.global(i, i + 3, "struct")?
        if layers != 0 { return Ok(slice_type(10000 + qualified)) }
        return Ok(10000 + qualified)
    }
    if c.word(tok.start, tok.end, [82, 101, 115, 117, 108, 116]) { // Result
        if layers != 0 || !decl::at(&c.graph.input, i + 1, "<") {
            return Err(c.issue(start, "expected Result<T, E>"))
        }
        let success_start = i + 2
        let comma = decl::parse_type(&c.graph.input, success_start)?
        let error_start = decl::expect(&c.graph.input, comma, ",")?
        let close = decl::parse_type(&c.graph.input, error_start)?
        let after = decl::expect(&c.graph.input, close, ">")?
        let success = c.type_at(success_start)?
        let failure = c.type_at(error_start)?
        if !is_payload(success) || !is_payload(failure) {
            return Err(c.issue(start, "Result payload must be a scalar, struct, or slice"))
        }
        return Ok(result_type(success, failure))
    }
    if c.word(tok.start, tok.end, [79, 112, 116, 105, 111, 110]) { // Option
        if layers != 0 || !decl::at(&c.graph.input, i + 1, "<") {
            return Err(c.issue(start, "expected Option<T>"))
        }
        let payload = c.type_at(i + 2)?
        let close = decl::parse_type(&c.graph.input, i + 2)?
        let after = decl::expect(&c.graph.input, close, ">")?
        if !is_payload(payload) { return Err(c.issue(start, "Option payload must be a scalar, struct, or slice")) }
        return Ok(option_type(payload))
    }
    if decl::at(&c.graph.input, i + 1, "::") || decl::at(&c.graph.input, i + 1, "<") {
        return Err(c.issue(start, "type is outside the bootstrap subset"))
    }
    if c.word(tok.start, tok.end, [105, 110, 116]) { return Ok(layers + 1) } // int
    if c.word(tok.start, tok.end, [102, 108, 111, 97, 116]) { return Ok(layers + 2) } // float
    if c.word(tok.start, tok.end, [98, 111, 111, 108]) { return Ok(layers + 3) } // bool
    if c.word(tok.start, tok.end, [115, 116, 114, 105, 110, 103]) { return Ok(layers + 4) } // string
    let index = c.global(i, i + 1, "struct")?
    if index >= 0 {
        if layers != 0 { return Ok(slice_type(10000 + index)) }
        return Ok(10000 + index)
    }
    return Err(c.issue(start, "type is outside the bootstrap subset"))
}

fn (c: &Checked) local(scope: &Scope, start: int, end: int) -> int {
    let mut i = scope.visible
    while i > 0 {
        i = i - 1
        if c.same_name(start, end, scope.locals[i].start, scope.locals[i].end) { return i }
    }
    return -1
}

fn (c: &Checked) define(scope: &mut Scope, start: int, end: int, typ: int, mutable: bool, token: int) -> Result<bool, imports::ParseError> {
    if c.word(start, end, [95]) { return Ok(true) } // _
    if c.local(&*scope, start, end) >= 0 { return Err(c.issue(token, "name already declared in this scope")) }
    let binding = Local { start: start, end: end, typ: typ, mutable: mutable, moved: false, owner: -1, last_use: -1 }
    if scope.visible == len(scope.locals) {
        push(&mut scope.locals, binding)
    } else {
        scope.locals[scope.visible] = binding
    }
    scope.visible = scope.visible + 1
    return Ok(true)
}

fn (c: &Checked) define_node(scope: &mut Scope, id: int, typ: int, mutable: bool) -> Result<bool, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let tok = &c.graph.input.tokens[node.first]
    return c.define(scope, tok.start, tok.end, typ, mutable, node.first)
}

fn (c: &Checked) import_target(token: int) -> Result<int, imports::ParseError> {
    let alias = &c.graph.input.tokens[token]
    for imported in c.graph.imports {
        if imported.file == alias.file && c.same_name(alias.start, alias.end, imported.start, imported.end) {
            return Ok(imported.target)
        }
    }
    return Err(c.issue(token, "unknown import alias"))
}

fn (c: &Checked) global(first: int, next: int, kind: string) -> Result<int, imports::ParseError> {
    let origin = c.graph.input.tokens[first].file
    let mut target = origin
    if next - first == 3 { target = c.import_target(first)? }
    let name = &c.graph.input.tokens[next - 1]
    for i, header in c.headers {
        if header.kind == kind && !header.method && c.graph.input.tokens[header.name_token].file == target &&
            c.same_name(name.start, name.end, header.name.start, header.name.end) {
            if target != origin && !header.public { return Err(c.issue(first, "imported declaration is private")) }
            return Ok(i)
        }
    }
    if next - first == 3 { return Err(c.issue(first, "imported declaration was not found")) }
    return Ok(-1)
}

pub fn (c: &Checked) function(first: int, next: int) -> Result<int, imports::ParseError> {
    return c.global(first, next, "fn")
}

pub fn (c: &Checked) is_entry(index: int) -> bool {
    let header = &c.headers[index]
    return header.kind == "fn" && !header.method && c.graph.input.tokens[header.name_token].file == 0 &&
        c.word(header.name.start, header.name.end, [109, 97, 105, 110])
}

fn (c: &Checked) field(typ: int, id: int) -> Result<int, imports::ParseError> {
    let tok_id = c.tree.nodes[id].first
    if !is_struct(typ) { return Err(c.issue(tok_id, "field access requires a struct")) }
    let tok = &c.graph.input.tokens[tok_id]
    for i, field in c.headers[typ - 10000].bindings {
        if c.same_name(tok.start, tok.end, field.name.start, field.name.end) { return Ok(i) }
    }
    return Err(c.issue(tok_id, "unknown struct field"))
}

fn (c: &Checked) field_type(typ: int, id: int) -> Result<int, imports::ParseError> {
    let base = dereference(typ)
    let index = c.field(base, id)?
    return c.type_at(c.headers[base - 10000].bindings[index].type_token)
}

pub fn (c: &Checked) method(typ: int, name: int) -> Result<int, imports::ParseError> {
    let tok_id = c.tree.nodes[name].first
    let base = dereference(typ)
    let tok = &c.graph.input.tokens[tok_id]
    for i, header in c.headers {
        if header.method && c.same_name(tok.start, tok.end, header.name.start, header.name.end) {
            let receiver_type = c.type_at(header.receiver_type_token)?
            if dereference(receiver_type) == base {
                if !header.public && tok.file != c.graph.input.tokens[header.name_token].file {
                    return Err(c.issue(tok_id, "imported method is private"))
                }
                return Ok(i)
            }
        }
    }
    return Err(c.issue(tok_id, "unknown method for this receiver"))
}

fn (c: &Checked) struct_literal(scope: &mut Scope, id: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let name = &c.tree.nodes[node.children[0]]
    let index = c.global(name.first, name.next, "struct")?
    if index < 0 { return Err(c.issue(name.first, "unknown struct type")) }
    let typ = 10000 + index
    let mut seen: []bool = []
    for _ in c.headers[index].bindings { push(&mut seen, false) }
    let mut i = 1
    while i < len(node.children) {
        let init = &c.tree.nodes[node.children[i]]
        let field_index = c.field(typ, init.children[0])?
        if seen[field_index] { return Err(c.issue(init.first, "duplicate struct field initializer")) }
        seen[field_index] = true
        let expected = c.type_at(c.headers[index].bindings[field_index].type_token)?
        let actual = c.consume(scope, init.children[1], expected)?
        if actual != expected { return Err(c.issue(init.first, "struct field type mismatch")) }
        i = i + 1
    }
    for present in seen {
        if !present { return Err(c.issue(node.first, "missing struct field initializer")) }
    }
    return Ok(typ)
}

fn (c: &Checked) mutable_local(scope: &Scope, id: int) -> Result<int, imports::ParseError> {
    let target = &c.tree.nodes[id]
    if target.kind != "name" || target.next != target.first + 1 {
        return Err(c.issue(target.first, "expected a mutable local name"))
    }
    let tok = &c.graph.input.tokens[target.first]
    let i = c.local(scope, tok.start, tok.end)
    if i < 0 { return Err(c.issue(target.first, "unknown assignment target")) }
    if !scope.locals[i].mutable { return Err(c.issue(target.first, "assignment to immutable name")) }
    return Ok(scope.locals[i].typ)
}

fn (c: &Checked) push_call(scope: &mut Scope, id: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    if len(node.children) != 3 { return Err(c.issue(node.first, "push expects two arguments")) }
    let target = node.children[1]
    let borrow = c.expr(scope, target, -1)?
    let typ = dereference(borrow)
    if !is_mut_reference(borrow) || !is_slice(typ) { return Err(c.issue(c.tree.nodes[target].first, "push expects &mut slice")) }
    let elem = slice_element(typ)
    let held = c.hold(scope, target, true)?
    let value = c.consume(scope, node.children[2], elem)?
    if value != elem { return Err(c.issue(node.first, "push element type mismatch")) }
    return Ok(0)
}

pub fn (c: &Checked) variant(name: int) -> int {
    let tok = &c.graph.input.tokens[c.tree.nodes[name].first]
    if c.word(tok.start, tok.end, [79, 107]) { return 1 } // Ok
    if c.word(tok.start, tok.end, [69, 114, 114]) { return 2 } // Err
    if c.word(tok.start, tok.end, [83, 111, 109, 101]) { return 3 } // Some
    if c.word(tok.start, tok.end, [78, 111, 110, 101]) { return 4 } // None
    return 0
}

fn (c: &Checked) call(scope: &mut Scope, id: int, expected: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let callee = &c.tree.nodes[node.children[0]]
    if callee.kind == "field" {
        let recv = callee.children[0]
        let actual = c.expr(scope, recv, -1)?
        let index = c.method(actual, callee.children[1])?
        let want = c.type_at(c.headers[index].receiver_type_token)?
        if is_mut_reference(want) {
            let writable = c.writable_type(scope, recv)?
        }
        if is_reference(want) {
            let held = c.hold(scope, recv, is_mut_reference(want))?
        } else {
            let moved = c.move_value(scope, recv, want)?
        }
        return c.call_arguments(scope, id, index)
    }
    if callee.kind != "name" {
        return Err(c.issue(callee.first, "call is outside the bootstrap subset"))
    }
    if callee.next != callee.first + 1 {
        let imported = c.function(callee.first, callee.next)?
        return c.call_arguments(scope, id, imported)
    }
    let tok = &c.graph.input.tokens[callee.first]
    let argc = len(node.children) - 1
    let variant = c.variant(node.children[0])
    if variant == 4 { return Err(c.issue(callee.first, "None is a value, not a call")) }
    if variant == 3 {
        if argc != 1 { return Err(c.issue(callee.first, "Some expects one argument")) }
        let mut want = -1
        if is_option(expected) { want = option_payload(expected) }
        let actual = c.consume(scope, node.children[1], want)?
        if !is_payload(actual) { return Err(c.issue(callee.first, "Option payload must be a scalar, struct, or slice")) }
        if want >= 0 && actual != want { return Err(c.issue(callee.first, "Option payload type mismatch")) }
        return Ok(option_type(actual))
    }
    if variant == 1 || variant == 2 {
        if !is_result(expected) { return Err(c.issue(callee.first, "Result constructor needs a Result type context")) }
        if argc != 1 { return Err(c.issue(callee.first, "Result constructor expects one argument")) }
        let want = result_variant_type(expected, variant)
        let actual = c.consume(scope, node.children[1], want)?
        if actual != want { return Err(c.issue(c.tree.nodes[node.children[1]].first, "Result payload type mismatch")) }
        return Ok(expected)
    }
    if c.word(tok.start, tok.end, [114, 101, 97, 100, 95, 98, 121, 116, 101, 115]) { // read_bytes
        if argc != 1 { return Err(c.issue(callee.first, "read_bytes expects one argument")) }
        let path_type = c.expr(scope, node.children[1], 4)?
        if path_type != 4 { return Err(c.issue(callee.first, "read_bytes expects a string path")) }
        return Ok(file_result_type())
    }
    if c.word(tok.start, tok.end, [119, 114, 105, 116, 101, 95, 116, 101, 120, 116]) { // write_text
        if argc != 2 { return Err(c.issue(callee.first, "write_text expects two arguments")) }
        let path_type = c.read_arg(scope, node.children[1], 4)?
        let text_type = c.read_arg(scope, node.children[2], 4)?
        if path_type != 4 || text_type != 4 { return Err(c.issue(callee.first, "write_text expects string arguments")) }
        return Ok(write_result_type())
    }
    if c.word(tok.start, tok.end, [98, 121, 116, 101, 115, 95, 116, 111, 95, 115, 116, 114, 105, 110, 103]) {
        if argc != 1 { return Err(c.issue(callee.first, "bytes_to_string expects one argument")) }
        let bytes_type = c.expr(scope, node.children[1], 11)?
        if bytes_type != 11 { return Err(c.issue(callee.first, "bytes_to_string expects []int")) }
        return Ok(4)
    }
    if c.word(tok.start, tok.end, [110, 97, 116, 105, 118, 101, 95, 99]) { // native_c
        if argc != 3 { return Err(c.issue(callee.first, "native_c expects three arguments")) }
        let source_type = c.read_arg(scope, node.children[1], 4)?
        let output_type = c.read_arg(scope, node.children[2], 4)?
        let args_type = c.read_arg(scope, node.children[3], 14)?
        if source_type != 4 || output_type != 4 || args_type != 14 {
            return Err(c.issue(callee.first, "native_c expects string, string and []string"))
        }
        return Ok(1)
    }
    if c.word(tok.start, tok.end, [112, 117, 115, 104]) { return c.push_call(scope, id) } // push
    if c.word(tok.start, tok.end, [108, 101, 110]) { // len
        if argc != 1 { return Err(c.issue(callee.first, "len expects one argument")) }
        let arg = c.expr(scope, node.children[1], -1)?
        if arg != 4 && !is_slice(arg) { return Err(c.issue(callee.first, "len expects a string or slice")) }
        return Ok(1)
    }
    if c.word(tok.start, tok.end, [112, 114, 105, 110, 116]) || // print
        c.word(tok.start, tok.end, [112, 114, 105, 110, 116, 108, 110]) || // println
        c.word(tok.start, tok.end, [101, 112, 114, 105, 110, 116, 108, 110]) { // eprintln
        let mut i = 1
        while i <= argc {
            let child = node.children[i]
            let arg_type = c.read_arg(scope, child, -1)?
            if dereference(arg_type) < 1 || dereference(arg_type) > 4 { return Err(c.issue(callee.first, "print expects scalar values")) }
            i = i + 1
        }
        return Ok(0)
    }
    let index = c.function(callee.first, callee.next)?
    if index < 0 { return Err(c.issue(callee.first, "unknown function")) }
    if c.is_entry(index) { return Err(c.issue(callee.first, "main cannot be called")) }
    return c.call_arguments(scope, id, index)
}

fn (c: &Checked) root(id: int) -> int {
    let node = &c.tree.nodes[id]
    if node.kind == "name" && node.next == node.first + 1 { return node.first }
    if node.kind == "field" || node.kind == "index" || node.kind == "unary:*" ||
        node.kind == "unary:&" || node.kind == "unary:&mut" || node.kind == "group" {
        return c.root(node.children[0])
    }
    return -1
}

fn (c: &Checked) root_local(scope: &Scope, id: int) -> int {
    let root = c.root(id)
    if root < 0 { return -1 }
    let token = &c.graph.input.tokens[root]
    return c.local(scope, token.start, token.end)
}

fn (scope: &Scope) owner(index: int) -> int {
    if index >= 0 && scope.locals[index].owner >= 0 { return scope.locals[index].owner }
    return index
}

fn (c: &Checked) check_loan(scope: &Scope, owner: int, exclusive: bool, token: int) -> Result<bool, imports::ParseError> {
    if owner < 0 { return Ok(true) }
    let mut i = 0
    while i < scope.loan_count {
        if scope.loans[i].owner == owner && (exclusive || scope.loans[i].mutable) {
            return Err(c.issue(token, "conflicting borrows in call or expression"))
        }
        i = i + 1
    }
    if exclusive {
        let mut j = 0
        while j < scope.visible {
            let local = &scope.locals[j]
            if local.owner == owner && local.last_use >= token {
                return Err(c.issue(token, "conflicting borrow: value is still shared"))
            }
            j = j + 1
        }
    }
    return Ok(true)
}

fn (c: &Checked) hold(scope: &mut Scope, id: int, mutable: bool) -> Result<bool, imports::ParseError> {
    let owner = scope.owner(c.root_local(&*scope, id))
    if owner < 0 { return Ok(true) }
    let checked = c.check_loan(&*scope, owner, mutable, c.tree.nodes[id].first)?
    let loan = Loan { owner: owner, mutable: mutable }
    if scope.loan_count == len(scope.loans) { push(&mut scope.loans, loan) }
    else { scope.loans[scope.loan_count] = loan }
    scope.loan_count = scope.loan_count + 1
    return Ok(true)
}

fn owning(typ: int) -> bool { return typ == 4 || is_struct(typ) || is_slice(typ) || is_option(typ) || is_result(typ) }

fn (c: &Checked) read_arg(scope: &mut Scope, id: int, expected: int) -> Result<int, imports::ParseError> {
    let typ = c.expr(scope, id, expected)?
    if owning(typ) || is_reference(typ) { let held = c.hold(scope, id, false)? }
    return Ok(typ)
}

fn (c: &Checked) move_value(scope: &mut Scope, id: int, typ: int) -> Result<bool, imports::ParseError> {
    if !owning(typ) || !c.place(id) { return Ok(true) }
    let index = c.root_local(&*scope, id)
    if index < 0 { return Ok(true) }
    let token = c.tree.nodes[id].first
    if is_reference(scope.locals[index].typ) { return Err(c.issue(token, "cannot move out of a borrowed value")) }
    if index < scope.loop_locals { return Err(c.issue(token, "cannot move a value declared outside a repeating loop")) }
    let checked = c.check_loan(&*scope, index, true, token)?
    scope.locals[index].moved = true
    return Ok(true)
}

fn (c: &Checked) consume(scope: &mut Scope, id: int, expected: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    if node.kind == "group" {
        let typ = c.consume(scope, node.children[0], expected)?
        scope.types[id] = typ
        return Ok(typ)
    }
    if node.kind == "match_expression" {
        let typ = c.check_match(scope, id, expected, true)?
        scope.types[id] = typ
        return Ok(typ)
    }
    let typ = c.expr(scope, id, expected)?
    let moved = c.move_value(scope, id, typ)?
    return Ok(typ)
}

fn (scope: &Scope) moved_flags() -> []bool {
    let mut flags: []bool = []
    let mut i = 0
    while i < scope.visible {
        push(&mut flags, scope.locals[i].moved)
        i = i + 1
    }
    return flags
}

fn (scope: &mut Scope) restore_moves(flags: &[]bool) {
    for index, moved in flags { scope.locals[index].moved = moved }
}

fn (scope: &mut Scope) merge_moves(flags: &[]bool) {
    for index, moved in flags {
        if moved { scope.locals[index].moved = true }
    }
}

fn (c: &Checked) call_arguments(scope: &mut Scope, id: int, index: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let header = &c.headers[index]
    let argc = len(node.children) - 1
    if argc != len(header.bindings) { return Err(c.issue(node.first, "wrong number of arguments")) }
    let mut i = 0
    while i < argc {
        let want = c.type_at(header.bindings[i].type_token)?
        let child = node.children[i + 1]
        let actual = c.consume(scope, child, want)?
        if actual != want { return Err(c.issue(c.tree.nodes[child].first, "argument type mismatch")) }
        if is_reference(actual) {
            let held = c.hold(scope, child, is_mut_reference(actual))?
        }
        i = i + 1
    }
    return c.type_at(header.return_type_token)
}

fn (c: &Checked) binary(scope: &mut Scope, id: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let left = c.expr(scope, node.children[0], -1)?
    let loan_count = scope.loan_count
    if owning(left) { let held = c.hold(scope, node.children[0], false)? }
    let mut before: []bool = []
    let short_circuit = node.kind == "binary:&&" || node.kind == "binary:||"
    if short_circuit { before = scope.moved_flags() }
    let right = c.expr(scope, node.children[1], -1)?
    scope.loan_count = loan_count
    if short_circuit { scope.merge_moves(&before) }
    if left != right { return Err(c.issue(node.first, "binary operands have different types")) }
    if node.kind == "binary:&&" || node.kind == "binary:||" {
        if left == 3 { return Ok(3) }
    } else if node.kind == "binary:==" || node.kind == "binary:!=" {
        if left >= 1 && left <= 4 { return Ok(3) }
    } else if node.kind == "binary:<" || node.kind == "binary:<=" ||
        node.kind == "binary:>" || node.kind == "binary:>=" {
        if left == 1 || left == 2 { return Ok(3) }
    } else if node.kind == "binary:+" && left == 4 {
        return Ok(4)
    } else if node.kind == "binary:%" {
        if left == 1 { return Ok(1) }
    } else if left == 1 || left == 2 {
        return Ok(left)
    }
    return Err(c.issue(node.first, "operator does not accept this type"))
}

fn (c: &Checked) slice_literal(scope: &mut Scope, id: int, expected: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let mut elem = -1
    if is_slice(expected) { elem = slice_element(expected) }
    for child in node.children {
        let actual = c.consume(scope, child, elem)?
        if actual == 0 { return Err(c.issue(node.first, "slice elements must have values")) }
        if is_slice(actual) { return Err(c.issue(node.first, "nested slices are outside the bootstrap subset")) }
        if !is_struct(actual) && (actual < 1 || actual > 4) {
            return Err(c.issue(node.first, "slice element must be a scalar or struct"))
        }
        if elem == -1 { elem = actual }
        if actual != elem { return Err(c.issue(c.tree.nodes[child].first, "slice element type mismatch")) }
    }
    if elem < 0 { return Err(c.issue(node.first, "empty slice needs a type")) }
    return Ok(slice_type(elem))
}

fn (c: &Checked) subscript(scope: &mut Scope, id: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let base = dereference(c.expr(scope, node.children[0], -1)?)
    let loan_count = scope.loan_count
    if node.kind == "slice" { let held = c.hold(scope, node.children[0], false)? }
    let mut i = 1
    while i < len(node.children) {
        let child = node.children[i]
        if child >= 0 {
            let bound = c.expr(scope, child, 1)?
            if bound != 1 { return Err(c.issue(c.tree.nodes[child].first, "index or bound must be int")) }
        }
        i = i + 1
    }
    scope.loan_count = loan_count
    if node.kind == "index" && is_slice(base) { return Ok(slice_element(base)) }
    if node.kind == "slice" {
        if base == 4 || (base >= 11 && base <= 13) { return Ok(base) }
    }
    return Err(c.issue(node.first, "cannot subscript this type"))
}

fn (c: &Checked) expr(scope: &mut Scope, id: int, expected: int) -> Result<int, imports::ParseError> {
    let typ = c.raw_expr(scope, id, expected)?
    scope.types[id] = typ
    return Ok(typ)
}

fn (c: &Checked) raw_expr(scope: &mut Scope, id: int, expected: int) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    if node.kind == "INT" { return Ok(1) }
    if node.kind == "FLOAT" { return Ok(2) }
    if node.kind == "true" || node.kind == "false" { return Ok(3) }
    if node.kind == "STRING" { return Ok(4) }
    if node.kind == "name" {
        if node.next != node.first + 1 { return Err(c.issue(node.first, "qualified name is outside the bootstrap subset")) }
        let tok = &c.graph.input.tokens[node.first]
        if c.variant(id) == 4 {
            if !is_option(expected) { return Err(c.issue(node.first, "None needs an Option type context")) }
            return Ok(expected)
        }
        let index = c.local(&*scope, tok.start, tok.end)
        if index < 0 { return Err(c.issue(node.first, "unknown local name")) }
        if scope.locals[index].moved { return Err(c.issue(node.first, "use of moved value")) }
        let checked = c.check_loan(&*scope, scope.owner(index), false, node.first)?
        return Ok(scope.locals[index].typ)
    }
    if node.kind == "group" { return c.expr(scope, node.children[0], expected) }
    if node.kind == "unary:&" || node.kind == "unary:&mut" {
        let child = node.children[0]
        let mutable = node.kind == "unary:&mut"
        if !c.place(child) { return Err(c.issue(node.first, "borrow requires a place")) }
        let inner = c.expr(scope, child, -1)?
        if inner <= 0 { return Err(c.issue(node.first, "bootstrap references require a value type")) }
        if mutable { let writable = c.writable_type(scope, child)? }
        return Ok(reference(inner, mutable))
    }
    if node.kind == "unary:*" {
        let inner = c.expr(scope, node.children[0], -1)?
        if !is_reference(inner) { return Err(c.issue(node.first, "dereference requires a reference")) }
        return Ok(dereference(inner))
    }
    if node.kind == "try" {
        let result = c.consume(scope, node.children[0], -1)?
        if !is_result(result) || !is_result(scope.return_type) {
            return Err(c.issue(node.first, "? requires a Result operand and return type"))
        }
        if result_variant_type(result, 2) != result_variant_type(scope.return_type, 2) {
            return Err(c.issue(node.first, "? error type differs from the function return type"))
        }
        return Ok(result_variant_type(result, 1))
    }
    if node.kind == "call" {
        let loan_count = scope.loan_count
        let typ = c.call(scope, id, expected)?
        scope.loan_count = loan_count
        return Ok(typ)
    }
    if node.kind == "struct_literal" { return c.struct_literal(scope, id) }
    if node.kind == "field" {
        let base = c.expr(scope, node.children[0], -1)?
        return c.field_type(base, node.children[1])
    }
    if node.kind == "match_expression" { return c.check_match(scope, id, expected, false) }
    if node.kind == "slice_literal" { return c.slice_literal(scope, id, expected) }
    if node.kind == "index" || node.kind == "slice" { return c.subscript(scope, id) }
    if node.kind == "unary:!" || node.kind == "unary:-" {
        let actual = c.expr(scope, node.children[0], -1)?
        if node.kind == "unary:!" && actual == 3 { return Ok(3) }
        if node.kind == "unary:-" && (actual == 1 || actual == 2) { return Ok(actual) }
        return Err(c.issue(node.first, "unary operator does not accept this type"))
    }
    if len(node.kind) >= 7 && node.kind[:7] == "binary:" { return c.binary(scope, id) }
    return Err(c.issue(node.first, "expression is outside the bootstrap subset"))
}

fn (c: &Checked) arm_expression(scope: &mut Scope, id: int, expected: int, moving: bool) -> Result<int, imports::ParseError> {
    let body = &c.tree.nodes[id]
    if body.kind != "block" {
        if moving { return c.consume(scope, id, expected) }
        return c.expr(scope, id, expected)
    }
    let count = len(body.children)
    if count == 0 { return Err(c.issue(body.first, "match expression arm needs a value")) }
    let saved_end = scope.block_end
    scope.block_end = body.next
    let mut i = 0
    while i + 1 < count {
        let returns = c.stmt(scope, body.children[i])?
        if returns { return Err(c.issue(body.first, "match expression arm returns before its value")) }
        i = i + 1
    }
    let tail = &c.tree.nodes[body.children[count - 1]]
    if tail.kind != "expr_stmt" { return Err(c.issue(tail.first, "match expression arm needs a value")) }
    let mut typ = 0
    if moving { typ = c.consume(scope, tail.children[0], expected)? }
    else { typ = c.expr(scope, tail.children[0], expected)? }
    scope.block_end = saved_end
    return Ok(typ)
}

// A statement match reports -2 if both arms return, otherwise 0.
// An expression match reports the common value type.
fn (c: &Checked) check_match(scope: &mut Scope, id: int, expected: int, moving: bool) -> Result<int, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let subject = c.consume(scope, node.children[0], -1)?
    let optional = is_option(subject)
    if !is_result(subject) && !optional { return Err(c.issue(node.first, "bootstrap match expects Option or Result")) }
    let mut first_variant = 1
    if optional { first_variant = 3 }
    let is_expression = node.kind == "match_expression"
    let mut saw_ok = false
    let mut saw_err = false
    let mut all_return = true
    let mut value_type = expected
    let before = scope.moved_flags()
    let mut merged: []bool = []
    let mut has_continuation = false
    let mut i = 1
    while i < len(node.children) {
        let arm = &c.tree.nodes[node.children[i]]
        let pattern = &c.tree.nodes[arm.children[0]]
        let variant = c.variant(pattern.children[0])
        if optional {
            if (variant == 3 && pattern.children[1] < 0) || (variant == 4 && pattern.children[1] >= 0) ||
                (variant != 3 && variant != 4) {
                return Err(c.issue(pattern.first, "expected Some(binding) or None"))
            }
        } else if (variant != 1 && variant != 2) || pattern.children[1] < 0 {
            return Err(c.issue(pattern.first, "expected Ok(binding) or Err(binding)"))
        }
        if (variant == first_variant && saw_ok) || (variant == first_variant + 1 && saw_err) {
            if optional { return Err(c.issue(pattern.first, "duplicate Option match arm")) }
            return Err(c.issue(pattern.first, "duplicate Result match arm"))
        }
        if variant == first_variant { saw_ok = true }
        else { saw_err = true }
        let visible = scope.visible
        scope.restore_moves(&before)
        if pattern.children[1] >= 0 {
            let mut payload = option_payload(subject)
            if !optional { payload = result_variant_type(subject, variant) }
            let bound = c.define_node(scope, pattern.children[1], payload, false)?
        }
        let body = &c.tree.nodes[arm.children[1]]
        let mut returns = false
        if is_expression {
            let actual = c.arm_expression(scope, arm.children[1], value_type, moving)?
            if is_reference(actual) { return Err(c.issue(body.first, "match expressions cannot return references in bootstrap")) }
            if actual == 0 { return Err(c.issue(body.first, "match expression arm needs a value")) }
            if value_type < 0 { value_type = actual }
            if actual != value_type { return Err(c.issue(body.first, "match arms have different types")) }
        } else if body.kind == "block" {
            returns = c.block(scope, arm.children[1])?
        } else {
            let unused = c.expr(scope, arm.children[1], -1)?
        }
        scope.visible = visible
        all_return = all_return && returns
        if !returns {
            if has_continuation { scope.merge_moves(&merged) }
            merged = scope.moved_flags()
            has_continuation = true
        }
        i = i + 1
    }
    if !saw_ok || !saw_err {
        if optional { return Err(c.issue(node.first, "match must cover both Some and None")) }
        return Err(c.issue(node.first, "match must cover both Ok and Err"))
    }
    if has_continuation { scope.restore_moves(&merged) }
    if is_expression { return Ok(value_type) }
    if all_return { return Ok(-2) }
    return Ok(0)
}

fn (c: &Checked) let_stmt(scope: &mut Scope, id: int) -> Result<bool, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let mut expected = -1
    if node.children[1] >= 0 { expected = c.type_at(c.tree.nodes[node.children[1]].first)? }
    let actual = c.consume(scope, node.children[2], expected)?
    if is_mut_reference(actual) { return Err(c.issue(node.first, "local mutable reference bindings are outside the bootstrap subset")) }
    if actual == 0 { return Err(c.issue(node.first, "initializer must have a value")) }
    if expected >= 0 && actual != expected { return Err(c.issue(node.first, "initializer type mismatch")) }
    let index = scope.visible
    let installed = c.define_node(scope, node.children[0], actual, node.kind == "let_mut")?
    if is_reference(actual) && scope.visible > index {
        let owner = scope.owner(c.root_local(&*scope, node.children[2]))
        if owner >= 0 {
            scope.locals[index].owner = owner
            let local = &scope.locals[index]
            let mut last = -1
            for use_index, use in c.tree.nodes {
                if !scope.name_uses[use_index] || use.first < node.next || use.first >= scope.block_end { continue }
                let token = &c.graph.input.tokens[use.first]
                if use.first > last && c.same_name(local.start, local.end, token.start, token.end) { last = use.first }
            }
            // A reference used in a repeating loop stays live through its back edge.
            let mut live_until = last
            for loop in c.tree.nodes {
                if (loop.kind == "while" || loop.kind == "for") &&
                    loop.first >= node.next && loop.first <= last && last < loop.next && loop.next - 1 > live_until {
                    live_until = loop.next - 1
                }
            }
            scope.locals[index].last_use = live_until
        }
    }
    return Ok(false)
}

fn (c: &Checked) place(id: int) -> bool {
    let node = &c.tree.nodes[id]
    if node.kind == "name" { return node.next == node.first + 1 }
    if node.kind == "field" || node.kind == "index" || node.kind == "group" {
        return c.place(node.children[0])
    }
    return node.kind == "unary:*"
}

fn (c: &Checked) writable_type(scope: &mut Scope, id: int) -> Result<int, imports::ParseError> {
    let owner = scope.owner(c.root_local(&*scope, id))
    let checked = c.check_loan(&*scope, owner, true, c.tree.nodes[id].first)?
    let typ = c.raw_writable_type(scope, id)?
    scope.types[id] = typ
    return Ok(typ)
}

fn (c: &Checked) raw_writable_type(scope: &mut Scope, id: int) -> Result<int, imports::ParseError> {
    let target = &c.tree.nodes[id]
    if target.kind == "group" { return c.writable_type(scope, target.children[0]) }
    if target.kind == "unary:*" {
        let inner = c.expr(scope, target.children[0], -1)?
        if !is_mut_reference(inner) { return Err(c.issue(target.first, "write requires a mutable reference")) }
        return Ok(dereference(inner))
    }
    if target.kind == "field" {
        let base = c.writable_type(scope, target.children[0])?
        return c.field_type(base, target.children[1])
    }
    if target.kind == "index" {
        let base = c.writable_type(scope, target.children[0])?
        return c.subscript(scope, id)
    }
    if target.kind == "name" {
        let typ = c.expr(scope, id, -1)?
        if is_mut_reference(typ) { return Ok(typ) }
        if is_reference(typ) { return Err(c.issue(target.first, "assignment to immutable name")) }
    }
    return c.mutable_local(&*scope, id)
}

fn (c: &Checked) assign(scope: &mut Scope, id: int) -> Result<bool, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let mut target = node.children[0]
    while c.tree.nodes[target].kind == "group" { target = c.tree.nodes[target].children[0] }
    let mut expected = 0
    let mut index = -1
    if c.tree.nodes[target].kind == "name" {
        index = c.root_local(&*scope, target)
        expected = c.mutable_local(&*scope, target)?
        scope.types[node.children[0]] = expected
        scope.types[target] = expected
    } else { expected = c.writable_type(scope, node.children[0])? }
    if is_reference(expected) { return Err(c.issue(node.first, "cannot reassign a reference parameter")) }
    let actual = c.consume(scope, node.children[1], expected)?
    if actual != expected { return Err(c.issue(node.first, "assignment type mismatch")) }
    if index >= 0 {
        let checked = c.check_loan(&*scope, index, true, node.next)?
        scope.locals[index].moved = false
    } else {
        let root = c.root_local(&*scope, target)
        if root >= 0 && scope.locals[root].moved { return Err(c.issue(node.first, "use of moved value")) }
    }
    return Ok(false)
}

fn (c: &Checked) for_stmt(scope: &mut Scope, id: int) -> Result<bool, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let loop_locals = scope.loop_locals
    scope.loop_locals = scope.visible
    let iter = dereference(c.expr(scope, node.children[2], -1)?)
    if !is_slice(iter) { return Err(c.issue(node.first, "for expects a slice")) }
    let visible = scope.visible
    let before = scope.moved_flags()
    let loan_count = scope.loan_count
    let held = c.hold(scope, node.children[2], false)?
    if node.children[0] >= 0 {
        let key_bound = c.define_node(scope, node.children[0], 1, false)?
    }
    let elem = slice_element(iter)
    let mut value_type = elem
    if elem == 4 || is_struct(elem) { value_type = reference(elem, false) }
    let value_bound = c.define_node(scope, node.children[1], value_type, false)?
    scope.loop_depth = scope.loop_depth + 1
    let done = c.block(scope, node.children[3])?
    scope.loop_depth = scope.loop_depth - 1
    scope.visible = visible
    scope.loan_count = loan_count
    scope.loop_locals = loop_locals
    scope.merge_moves(&before)
    return Ok(false)
}

fn (c: &Checked) stmt(scope: &mut Scope, id: int) -> Result<bool, imports::ParseError> {
    let node = &c.tree.nodes[id]
    if node.kind == "let" || node.kind == "let_mut" { return c.let_stmt(scope, id) }
    if node.kind == "assign" { return c.assign(scope, id) }
    if node.kind == "block" { return c.block(scope, id) }
    if node.kind == "expr_stmt" {
        let ignored = c.expr(scope, node.children[0], -1)?
        return Ok(false)
    }
    if node.kind == "return" {
        let mut actual = 0
        let expected_type = scope.return_type
        if len(node.children) > 0 {
            actual = c.consume(scope, node.children[0], expected_type)?
            if actual == 0 { return Err(c.issue(node.first, "return expression must have a value")) }
        }
        if actual != scope.return_type { return Err(c.issue(node.first, "return type mismatch")) }
        return Ok(true)
    }
    if node.kind == "if" {
        let cond = c.expr(scope, node.children[1], 3)?
        if cond != 3 { return Err(c.issue(node.first, "if condition must be bool")) }
        let before = scope.moved_flags()
        let then_returns = c.block(scope, node.children[2])?
        let then_moves = scope.moved_flags()
        scope.restore_moves(&before)
        let mut else_returns = false
        if node.children[3] >= 0 { else_returns = c.stmt(scope, node.children[3])? }
        if else_returns { scope.restore_moves(&then_moves) }
        else if !then_returns { scope.merge_moves(&then_moves) }
        return Ok(then_returns && else_returns)
    }
    if node.kind == "while" {
        let loop_locals = scope.loop_locals
        scope.loop_locals = scope.visible
        let cond = c.expr(scope, node.children[0], 3)?
        if cond != 3 { return Err(c.issue(node.first, "while condition must be bool")) }
        let before = scope.moved_flags()
        scope.loop_depth = scope.loop_depth + 1
        let done = c.block(scope, node.children[1])?
        scope.loop_depth = scope.loop_depth - 1
        scope.loop_locals = loop_locals
        scope.merge_moves(&before)
        return Ok(false)
    }
    if node.kind == "for" { return c.for_stmt(scope, id) }
    if node.kind == "match_statement" {
        let result = c.check_match(scope, id, -1, false)?
        return Ok(result == -2)
    }
    if node.kind == "break" || node.kind == "continue" {
        if scope.loop_depth == 0 { return Err(c.issue(node.first, "loop control outside a loop")) }
        return Ok(false)
    }
    return Err(c.issue(node.first, "statement is outside the bootstrap subset"))
}

fn (c: &Checked) block(scope: &mut Scope, id: int) -> Result<bool, imports::ParseError> {
    let node = &c.tree.nodes[id]
    let visible = scope.visible
    let saved_end = scope.block_end
    scope.block_end = node.next
    let mut returns = false
    for child in node.children {
        if returns { return Err(c.issue(c.tree.nodes[child].first, "unreachable statement after return")) }
        returns = c.stmt(scope, child)?
    }
    scope.visible = visible
    scope.block_end = saved_end
    return Ok(returns)
}

fn (c: &Checked) local_name_uses() -> []bool {
    let mut uses: []bool = []
    for node in c.tree.nodes { push(&mut uses, node.kind == "name" && node.next == node.first + 1) }
    for node in c.tree.nodes {
        if node.kind == "call" || node.kind == "struct_literal" || node.kind == "initializer" ||
            node.kind == "let" || node.kind == "let_mut" || node.kind == "pattern" {
            uses[node.children[0]] = false
        } else if node.kind == "for" && node.children[0] >= 0 {
            uses[node.children[0]] = false
        }
        if node.kind == "field" || node.kind == "for" || (node.kind == "pattern" && node.children[1] >= 0) {
            uses[node.children[1]] = false
        }
    }
    return uses
}

fn (c: &Checked) check() -> Result<[]int, imports::ParseError> {
    let mut has_main = false
    let mut types: []int = []
    for _ in c.tree.nodes { push(&mut types, 0) }
    let mut scope = Scope {
        locals: [], visible: 0, loop_depth: 0, return_type: 0, types: types,
        name_uses: c.local_name_uses(), loans: [], loan_count: 0, block_end: 0, loop_locals: 0,
    }
    let mut i = 0
    for header_index, header in c.headers {
        if header.kind != "fn" { continue }
        let root = c.tree.roots[i]
        i = i + 1
        let start = c.tree.nodes[root].first
        scope.visible = 0
        scope.return_type = c.type_at(header.return_type_token)?
        if is_reference(scope.return_type) { return Err(c.issue(start, "returning references is outside the bootstrap subset")) }
        if header.method {
            let receiver_type = c.type_at(header.receiver_type_token)?
            let binding = &c.graph.input.tokens[header.receiver_name_token]
            let installed = c.define(&mut scope, binding.start, binding.end, receiver_type, false, header.receiver_name_token)?
        }
        for param in header.bindings {
            let typ = c.type_at(param.type_token)?
            let bound = c.define(&mut scope, param.name.start, param.name.end, typ, false, param.type_token)?
        }
        if c.is_entry(header_index) {
            has_main = true
            if scope.return_type != 0 && scope.return_type != 1 {
                return Err(c.issue(start, "main must return nothing or int"))
            }
            if len(header.bindings) > 1 { return Err(c.issue(start, "main expects no parameter or []string")) }
            if len(header.bindings) == 1 {
                let main_arg = c.type_at(header.bindings[0].type_token)?
                if main_arg != 14 { return Err(c.issue(start, "main expects no parameter or []string")) }
            }
        }
        let returns = c.block(&mut scope, root)?
        if scope.return_type != 0 && !returns {
            return Err(c.issue(start, "function is missing a return on some paths"))
        }
    }
    if !has_main { return Err(c.issue(0, "expected a main function")) }
    return Ok(scope.types)
}

fn layout_ready(typ: int, available: &[]bool) -> bool {
    if is_option(typ) { return layout_ready(option_payload(typ), available) }
    if is_result(typ) {
        return layout_ready(result_variant_type(typ, 1), available) && layout_ready(result_variant_type(typ, 2), available)
    }
    let mut base = typ
    if is_struct_slice(typ) { base = slice_element(typ) }
    return !is_struct(base) || (*available)[base - 10000]
}

fn (c: &Checked) layout() -> Result<[]int, imports::ParseError> {
    let mut available: []bool = []
    let mut count = 0
    for i, header in c.headers {
        let receiver = c.type_at(header.receiver_type_token)?
        let file = c.graph.input.tokens[header.name_token].file
        if header.method && !is_struct(dereference(receiver)) {
            return Err(c.issue(header.receiver_type_token, "method receiver must be a struct"))
        }
        let mut j = 0
        while j < i {
            let prior = &c.headers[j]
            if header.method == prior.method && (header.method || file == c.graph.input.tokens[prior.name_token].file) &&
                c.same_name(header.name.start, header.name.end, prior.name.start, prior.name.end) {
                let previous_receiver = c.type_at(prior.receiver_type_token)?
                if dereference(receiver) == dereference(previous_receiver) {
                    return Err(imports::ParseError { line: header.line, col: header.col, message: "duplicate declaration name" })
                }
            }
            j = j + 1
        }
        if !header.method {
            for imported in c.graph.imports {
                if imported.file == file && c.same_name(header.name.start, header.name.end, imported.start, imported.end) {
                    return Err(c.issue(header.name_token, "declaration conflicts with import alias"))
                }
            }
        }
        let is_struct = header.kind == "struct"
        push(&mut available, !is_struct)
        if is_struct {
            count = count + 1
            for field_index, field in header.bindings {
                let typed = c.type_at(field.type_token)?
                if is_reference(typed) { return Err(c.issue(field.type_token, "struct fields cannot contain references")) }
                let mut previous = 0
                while previous < field_index {
                    let peer = &header.bindings[previous]
                    if c.same_name(field.name.start, field.name.end, peer.name.start, peer.name.end) {
                        return Err(c.issue(field.type_token, "duplicate struct field declaration"))
                    }
                    previous = previous + 1
                }
            }
        }
    }
    let mut order: []int = []
    while len(order) < count {
        let before = len(order)
        let mut pending = -1
        for index, declaration in c.headers {
            if available[index] { continue }
            pending = index
            let mut ready = true
            for binding in declaration.bindings {
                let typ = c.type_at(binding.type_token)?
                if !layout_ready(typ, &available) { ready = false }
            }
            if ready {
                available[index] = true
                push(&mut order, index)
            }
        }
        if len(order) == before {
            let stuck = &c.headers[pending]
            return Err(imports::ParseError { line: stuck.line, col: stuck.col, message: "recursive struct layout" })
        }
    }
    return Ok(order)
}

pub fn analyze(input: lexer::Lexed) -> Result<Checked, imports::ParseError> {
    for tok in input.tokens {
        if tok.kind == "import" { return Err(imports::ParseError {
            line: tok.line, col: tok.col, message: "imports require a source file path",
        }) }
    }
    return analyze_graph(modules::Graph { input: input, files: [], imports: [] })
}

pub fn analyze_file(path: &string, bytes: []int) -> Result<Checked, imports::ParseError> {
    let graph = modules::connect(path, bytes)?
    return analyze_graph(graph)
}

fn analyze_graph(graph: modules::Graph) -> Result<Checked, imports::ParseError> {
    let headers = decl::parse_declarations(&graph.input)?
    let tree = bodies::parse_with_headers(&graph.input, &headers)?
    let mut checker = Checked { graph: graph, headers: headers, tree: tree, expr_types: [], struct_order: [] }
    checker.struct_order = checker.layout()?
    checker.expr_types = checker.check()?
    return Ok(checker)
}

pub fn check(input: lexer::Lexed) -> Result<bool, imports::ParseError> {
    let checked = analyze(input)?
    return Ok(true)
}
